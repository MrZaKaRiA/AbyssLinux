# Ensure all input devices (keyboard, mouse, tablet, event) are accessible
KERNEL=="event*", SUBSYSTEM=="input", MODE="0666", GROUP="input"
KERNEL=="mouse*|mice", SUBSYSTEM=="input", MODE="0666", GROUP="input"
KERNEL=="js*", SUBSYSTEM=="input", MODE="0666", GROUP="input"
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0666", GROUP="input"
