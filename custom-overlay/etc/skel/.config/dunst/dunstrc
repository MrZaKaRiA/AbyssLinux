# ~/.config/dunst/dunstrc - Abyss Linux notifications
# Started by ~/.xinitrc. Super+Alt+c closes all, Super+Alt+h shows the last one again.
# Reload after editing: killall dunst (it is restarted by the next notification).

[global]
    monitor = 0
    follow = mouse
    origin = top-right
    # below the dwm bar; scale = 0 multiplies sizes by the Xft.dpi factor
    offset = (12, 36)
    scale = 0
    width = (280, 460)
    height = (0, 240)
    notification_limit = 5
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 0
    frame_width = 2
    frame_color = "#a855f7"
    gap_size = 6
    separator_color = frame
    corner_radius = 8
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = end
    show_age_threshold = 60
    stack_duplicates = true
    show_indicators = no
    icon_position = off
    history_length = 20
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0d0b18"
    foreground = "#c4b5fd"
    timeout = 5

[urgency_normal]
    background = "#0d0b18"
    foreground = "#f3e8ff"
    timeout = 8

[urgency_critical]
    background = "#2a0a14"
    foreground = "#fecdd3"
    frame_color = "#fb7185"
    timeout = 0
