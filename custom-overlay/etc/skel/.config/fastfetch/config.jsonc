{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/usr/share/abyss/abyss-logo.txt",
        "type": "file",
        "color": {
            "1": "magenta",
            "2": "cyan"
        },
        "padding": {
            "right": 3
        }
    },
    "display": {
        "separator": " 🌀 "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS",
            "format": "Abyss Linux (Void Base)"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        {
            "type": "packages",
            "key": "Packages"
        },
        {
            "type": "wm",
            "key": "WM",
            "format": "dwm (Suckless Custom)"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "format": "st (Simple Terminal)"
        },
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        {
            "type": "disk",
            "key": "Disk (/)"
        },
        "break",
        "colors"
    ]
}
