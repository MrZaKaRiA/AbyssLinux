# Abyss Linux GRUB Configuration (installed systems; the live ISO menu is
# generated by void-mklive, see builder/abyss-mklive-tweaks.sh)
GRUB_DEFAULT=0
# Silent boot: no menu, hold Esc (or Shift) during the timeout to show it.
GRUB_TIMEOUT=2
GRUB_TIMEOUT_STYLE=hidden
GRUB_DISTRIBUTOR="Abyss Linux"
# quiet + loglevel=3: only real errors reach the screen. Remove "quiet" to
# see the full kernel / runit boot log again (also kept in /run/abyss-boot.log).
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3 rd.udev.log_level=3 udev.log_level=3"
GRUB_BACKGROUND="/usr/share/backgrounds/abyss/abyss-splash.png"
GRUB_GFXMODE=1920x1080,1024x768,auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_COLOR_NORMAL="light-gray/black"
GRUB_COLOR_HIGHLIGHT="magenta/black"
