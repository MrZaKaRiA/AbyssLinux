# Abyss Linux GRUB Configuration (installed systems; the live ISO menu is
# generated by void-mklive, see builder/abyss-mklive-tweaks.sh)
GRUB_DEFAULT=0
# Silent boot: no menu, hold Shift (or press Esc) during the timeout to show it.
GRUB_TIMEOUT=1
GRUB_TIMEOUT_STYLE=hidden
GRUB_DISTRIBUTOR="Abyss Linux"
# quiet + splash: the Abyss logo (plymouth), errors only. Remove "quiet splash" to
# see the full kernel / runit boot log again (also kept in /run/abyss-boot.log).
# plymouth.ignore-serial-consoles: draw the logo on the screen even when the
# machine also has a serial console (virtual machines usually do).
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=3 rd.udev.log_level=3 udev.log_level=3 vt.global_cursor_default=0 plymouth.ignore-serial-consoles"
# The Abyss logo on black comes from /etc/grub.d/05_abyss_splash (abyss-boot);
# a GRUB_BACKGROUND or GRUB_THEME here replaces it.
#GRUB_BACKGROUND=
# auto: the mode the firmware already uses (the screen's own), so the logo is
# not resized and nothing flickers between the firmware, GRUB and Linux.
GRUB_GFXMODE=auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_COLOR_NORMAL="light-gray/black"
GRUB_COLOR_HIGHLIGHT="magenta/black"
