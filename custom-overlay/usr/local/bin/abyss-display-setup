#!/bin/sh
# ==============================================================================
# abyss-display-setup - LightDM display-setup-script (runs as root on the
# greeter's X server before the greeter starts).
# Gives the login screen the display scale the desktop will use (abyss-scale:
# sized for the screen). Override for everyone in /etc/abyss/dpi.
# ==============================================================================
if command -v abyss-scale >/dev/null 2>&1; then
    abyss-scale --greeter
else
    dpi=$(tr -dc 0-9 < /etc/abyss/dpi 2>/dev/null)
    command -v xrdb >/dev/null 2>&1 && echo "Xft.dpi: ${dpi:-96}" | xrdb -merge
    command -v abyss-cursor >/dev/null 2>&1 && abyss-cursor "${dpi:-96}"
fi
exit 0
