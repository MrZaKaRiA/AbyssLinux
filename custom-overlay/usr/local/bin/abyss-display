#!/bin/sh
# Lightweight RandR display picker. The kernel and graphics driver expose
# supported outputs, modes, and refresh rates; Abyss stores the chosen profile.
#
#   abyss-display                 menu
#   abyss-display --auto          every output on, left-to-right, best mode
#   abyss-display --restore       saved profile, --auto for anything not in it
#   abyss-display --auto-resolution [OUT]   stop using a fixed resolution
#   abyss-display --status        "OUTPUT automatic|fixed MODE" / "OUTPUT off"
#   abyss-display --rate [OUT]    refresh-rate picker
#   abyss-display --apply-rates   re-apply saved refresh rates
#   abyss-display --full-range [off]   full-range RGB on outputs that have the
#                                 driver's "Broadcast RGB" switch (Intel)
#
# Files in ~/.config/abyss:
#   monitors.sh     saved layout (written by the menu): positions, outputs
#                   that are off, and a mode only for a fixed resolution
#   fixed-resolution   outputs whose resolution was chosen in the picker.
#                   Everything else is automatic: it follows the display's
#                   preferred mode (in a virtual machine, the window size)
#   refresh-rates   "OUTPUT RATE" lines chosen in the rate picker; always win
#   refresh-auto    write "preferred" in it to stay on the display's own
#                   default rate. Without it an output with no saved rate runs
#                   at the highest rate it lists for its resolution, because
#                   high-refresh monitors usually mark 60 Hz as preferred.
#   full-range      present: --auto/--restore ask for full-range RGB

FONT='JetBrainsMono Nerd Font:size=10'
NB='#0d0b18' NF='#f3e8ff' SB='#a855f7' SF='#090514'
choose() { dmenu -i -c -l 18 -fn "$FONT" -nb "$NB" -nf "$NF" -sb "$SB" -sf "$SF" "$@"; }
has() { command -v "$1" >/dev/null 2>&1; }
notify() { has notify-send && notify-send -a Abyss 'Display setup' "$1" || echo "$1"; }
profile="$HOME/.config/abyss/monitors.sh"
# Refresh rate chosen on its own, one "OUTPUT RATE" per line. It is applied on
# top of whatever resolution is active, so the resolution can stay automatic.
rates="$HOME/.config/abyss/refresh-rates"
# Outputs with a resolution chosen by hand in the picker, one name per line.
pins="$HOME/.config/abyss/fixed-resolution"
AUTO_RES='Automatic resolution (follow the display / VM window)'
policy="$HOME/.config/abyss/refresh-auto"
fullrange="$HOME/.config/abyss/full-range"
# While a picker is open dwm-statusbar must not re-apply the layout under it.
picker="${XDG_RUNTIME_DIR:-$HOME/.cache}/abyss-display.pid"
hold_picker() {
    [ -n "${ABYSS_DISPLAY_PICKER:-}" ] && return 0
    ABYSS_DISPLAY_PICKER=$$; export ABYSS_DISPLAY_PICKER
    mkdir -p "${picker%/*}" 2>/dev/null
    echo $$ > "$picker" 2>/dev/null
    trap 'rm -f "$picker"' EXIT
    trap 'exit 1' HUP INT TERM
}
# "WIDTHxHEIGHT" of the X screen, from xrandr --query on stdin.
screen_size() { awk 'NR == 1 { for (i = 1; i < NF; i++) if ($i == "current") { print $(i + 1) "x" $(i + 3) + 0; exit } }'; }
# The pointer is sized for the screen, so re-fit it after every mode change.
# feh draws the wallpaper for one screen size: when the size changed (a VM
# window resized, another resolution) draw it again, or the old picture stays
# in the corner and repeats over the new area.
fit_desktop() {
    has abyss-cursor && abyss-cursor >/dev/null 2>&1
    f_size=$(xrandr --query 2>/dev/null | screen_size)
    if [ -n "$f_size" ] && [ "$f_size" != "$size" ]; then
        size=$f_size
        has abyss-wallpaper && abyss-wallpaper >/dev/null 2>&1
    fi
    :
}

query=$(xrandr --query 2>/dev/null)
size=$(printf '%s\n' "$query" | screen_size)
outputs=$(printf '%s\n' "$query" | awk '$2 == "connected" {print $1}')
[ -n "$outputs" ] || { [ "${1:-}" = --status ] || notify 'No connected display outputs found.'; exit 1; }

# Fixed resolution of output $1 according to the saved layout; empty when it
# is automatic. A virtual display advertises the VM window's size as its
# preferred mode, and layouts saved before 27.3.3 recorded the current mode of
# every output whether or not it had been chosen, so for Virtual-* a saved
# mode only counts when the picker listed the output in $pins. On real
# hardware an old saved mode is kept: there it was normally a real choice.
fixed_mode() {
    [ -r "$profile" ] || return 0
    case "$1" in Virtual*) [ -r "$pins" ] && grep -qxF -- "$1" "$pins" || return 0 ;; esac
    awk -v o="$1" '$1 == "xrandr" {
        out = ""; m = ""
        for (i = 2; i < NF; i++) { if ($i == "--output") out = $(i + 1); if ($i == "--mode") m = $(i + 1) }
        if (out == o && m != "") { print m; exit }
    }' "$profile"
}

# The saved layout as commands, with a mode that does not count (see
# fixed_mode) replaced by --auto so the output keeps its position only.
profile_cmds() {
    p_ok=' '
    [ -r "$pins" ] && p_ok=" $(tr '\n' ' ' < "$pins")"
    awk -v ok="$p_ok" '
        $1 == "xrandr" && / --mode / {
            out = ""
            for (i = 2; i < NF; i++) if ($i == "--output") out = $(i + 1)
            if (out ~ /^Virtual/ && !index(ok, " " out " ")) {
                line = $1
                for (i = 2; i <= NF; i++) {
                    if ($i == "--mode") { line = line " --auto"; i++ }
                    else if ($i == "--rate") i++
                    else line = line " " $i
                }
                print line; next
            }
        }
        { print }' "$profile"
}

# Write the layout: positions, outputs that are off, and a mode only for the
# outputs whose resolution is fixed ($1: output just fixed in the picker,
# $2: outputs going back to automatic). Every other output is saved as --auto,
# so saving a layout or a refresh rate never pins a resolution.
save_profile() {
    s_fixed=" ${1:-} "
    s_auto=" $(echo ${2:-}) "
    for s_o in $outputs; do
        case "$s_auto" in *" $s_o "*) continue ;; esac
        [ -z "$(fixed_mode "$s_o")" ] || s_fixed="$s_fixed$s_o "
    done
    mkdir -p "${profile%/*}"
    xrandr --query | awk -v fixed="$s_fixed" '
        function emit() {
            if (out == "") return
            if (mode == "" || rate == "") printf "xrandr --output %s --off\n", out
            else if (index(fixed, " " out " "))
                printf "xrandr --output %s --mode %s --rate %s --pos %sx%s\n", out, mode, rate, xpos, ypos
            else printf "xrandr --output %s --auto --pos %sx%s\n", out, xpos, ypos
        }
        $2 == "connected" {
            emit(); out=$1; mode=""; rate=""; xpos=0; ypos=0; inout=1
            for (i=3; i<=NF; i++) if ($i ~ /^[0-9]+x[0-9]+[+-]/) {
                g=$i; split(g,a,/[x+]/); mode=a[1] "x" a[2]; xpos=a[3]; ypos=a[4]
            }
            next
        }
        /^[^[:space:]]/ {inout=0}
        inout && mode != "" {
            for (i=2; i<=NF; i++) if ($i ~ /\*/) {
                r=$i; sub(/[+*].*$/, "", r); if (r ~ /^[0-9]+([.][0-9]+)?$/) rate=r
            }
        }
        END {emit()}
    ' > "$profile"
    awk '$1 == "xrandr" && / --mode / { for (i = 2; i < NF; i++) if ($i == "--output") print $(i + 1) }' "$profile" > "$pins"
    [ -s "$pins" ] || rm -f "$pins"
    # One automatic output at the origin is what no layout at all gives.
    [ "$(wc -l < "$profile")" -eq 1 ] && grep -q -- ' --auto --pos 0x0$' "$profile" && rm -f "$profile"
    :
}

output_modes() {
    common_only=$1
    xrandr --query 2>/dev/null | awk -v out="$output" -v common="$common_only" '
        function label(mode) {
            if (mode == "1920x1080") return "Full HD / 1080p"
            if (mode == "1920x1200") return "Full HD+ / WUXGA"
            if (mode == "2560x1080") return "Ultrawide 1080p"
            if (mode == "2560x1440") return "QHD / 2K / 1440p"
            if (mode == "2560x1600") return "WQXGA"
            if (mode == "2880x1800") return "MacBook Retina 15-inch class"
            if (mode == "3024x1964") return "MacBook Pro 14-inch class"
            if (mode == "3440x1440") return "Ultrawide QHD"
            if (mode == "3456x2234") return "MacBook Pro 16-inch class"
            if (mode == "3840x1080") return "Super ultrawide"
            if (mode == "3840x1600") return "Ultrawide WQHD+"
            if (mode == "3840x2160") return "4K UHD / 2160p"
            if (mode == "4096x2160") return "4K DCI"
            if (mode == "5120x1440") return "Dual QHD / super ultrawide"
            if (mode == "5120x2160") return "5K2K ultrawide"
            if (mode == "5120x2880") return "5K UHD+"
            if (mode == "6016x3384") return "6K / Pro Display XDR class"
            if (mode == "7680x4320") return "8K UHD"
            return ""
        }
        $1 == out && $2 == "connected" { inout=1; next }
        inout && /^[^[:space:]]/ { exit }
        inout && /^[[:space:]]+[0-9]+x[0-9]+/ {
            mode=$1; name=label(mode)
            if (common && name == "") next
            for (i=2; i<=NF; i++) {
                rate=$i; sub(/[+*].*$/, "", rate)
                if (rate ~ /^[0-9]+([.][0-9]+)?$/)
                    printf "%s @ %s Hz%s\n", mode, rate, (name == "" ? "" : " — " name)
            }
        }
    ' | sort -Vu
}

# Active mode of output $1: "MODE CURRENT PREFERRED RATE RATE ..." (PREFERRED
# is "-" when the display marks none). Empty when the output is off.
active_mode() {
    xrandr --query 2>/dev/null | awk -v out="$1" '
        $1 == out && $2 == "connected" { inout=1; next }
        inout && /^[^[:space:]]/ { exit }
        inout && /\*/ {
            cur=""; pref="-"; last=""; list=""
            for (i=2; i<=NF; i++) {
                if ($i == "+") { pref=last; continue }
                if ($i == "*") { cur=last; continue }
                r=$i; sub(/[+*]+$/, "", r)
                if (r !~ /^[0-9]+([.][0-9]+)?$/) continue
                if ($i ~ /\*/) cur=r
                if ($i ~ /\+/) pref=r
                last=r; list=list " " r
            }
            if (cur != "") print $1, cur, pref list
            exit
        }'
}

save_rate() {   # $1=output $2=rate (empty: forget it)
    mkdir -p "${rates%/*}"
    {
        [ -r "$rates" ] && awk -v o="$1" '$1 != o' "$rates"
        [ -n "$2" ] && printf '%s %s\n' "$1" "$2"
    } > "$rates.tmp"
    mv -f "$rates.tmp" "$rates"
}

# Re-apply saved rates when the active resolution still offers them; otherwise
# leave the display's own default alone.
apply_rates() {
    [ -r "$rates" ] || return 0
    while read -r r_out r_want _; do
        case "$r_out" in ''|\#*) continue ;; esac
        set -- $(active_mode "$r_out")
        [ $# -ge 4 ] || continue
        r_mode=$1 r_cur=$2; shift 3
        [ "$r_cur" = "$r_want" ] && continue
        for r in "$@"; do
            [ "$r" = "$r_want" ] || continue
            xrandr --output "$r_out" --mode "$r_mode" --rate "$r_want" 2>/dev/null
            break
        done
    done < "$rates"
}

auto_highest() {
    b_pol=
    [ -r "$policy" ] && read -r b_pol < "$policy"
    [ "$b_pol" != preferred ]
}

# Highest of the rates in $2.. when it is really above $1, else nothing.
higher_rate() {
    b_from=$1; shift
    printf '%s\n' "$@" | awk -v c="$b_from" '$1 + 0 > m {m = $1 + 0; s = $1} END {if (m > c + 1) print s}'
}

# Output $1 has no saved rate: raise it from the preferred rate to the highest
# one listed for the very same mode (never another resolution, never an
# interlaced mode, never downwards). The driver has already dropped modes the
# link cannot carry, and when the switch is refused we go back at once. What
# cannot be detected is a mode that is accepted but shows nothing (marginal
# cable, wrong DisplayPort version in the monitor's own menu): nobody is asked
# to confirm at login. The way out is, from a text console (Ctrl+Alt+F2):
#   echo preferred > ~/.config/abyss/refresh-auto
boost_rate() {
    auto_highest || return 0
    [ -r "$rates" ] && awk -v o="$1" '$1 == o {f = 1} END {exit !f}' "$rates" && return 0
    set -- "$1" $(active_mode "$1")
    [ $# -ge 5 ] || return 0
    b_out=$1 b_mode=$2 b_cur=$3; shift 4
    case "$b_mode" in *i) return 0 ;; esac
    b_top=$(higher_rate "$b_cur" "$@")
    [ -n "$b_top" ] || return 0
    xrandr --output "$b_out" --mode "$b_mode" --rate "$b_top" 2>/dev/null ||
        xrandr --output "$b_out" --mode "$b_mode" --rate "$b_cur" 2>/dev/null
    :
}

# The dwm bar and new windows start on the primary output: with a laptop panel
# and a big external screen that should be the big one.
set_primary() {
    p_out=$(xrandr --query 2>/dev/null | awk '
        $2 == "connected" {
            n++
            for (i = 3; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+[+-]/) {
                split($i, a, /[x+-]/)
                if (a[1] * a[2] > best) { best = a[1] * a[2]; out = $1 }
            }
        }
        END { if (n > 1) print out }')
    [ -z "$p_out" ] || xrandr --output "$p_out" --primary 2>/dev/null
    :
}

# Intel's driver sends limited-range RGB (16-235) for TV timings over HDMI;
# a monitor that expects full range then shows grey blacks. Only the user can
# tell a monitor from a TV, so this is applied on request, never guessed.
range_outputs() {
    xrandr --prop 2>/dev/null | awk '
        /^[^[:space:]]/ { out = ($2 == "connected") ? $1 : "" }
        out != "" && /^[[:space:]]+Broadcast RGB:/ { print out }'
}
apply_range() {   # $1=Full|Automatic
    for r_o in $(range_outputs); do
        xrandr --output "$r_o" --set 'Broadcast RGB' "$1" 2>/dev/null
    done
    :
}

pick_rate() {   # $1=output; keeps the resolution, changes only the rate
    output=$1
    set -- $(active_mode "$output")
    [ $# -ge 4 ] || { notify "$output is turned off. Turn it on first."; return 1; }
    mode=$1 cur=$2 pref=$3; shift 3
    list=$(printf '%s\n' "$@" | sort -rnu)
    if [ "$(printf '%s\n' "$list" | wc -l)" -le 1 ]; then
        notify "$output offers only $cur Hz at $mode. Virtual machines and some panels have a single refresh rate."
        return 0
    fi
    if auto_highest; then auto='Automatic (highest the display offers)'
    else auto='Automatic (display default)'; fi
    sel=$({
        echo "$auto"
        printf '%s\n' "$list" | awk -v c="$cur" -v p="$pref" '{printf "%s Hz%s%s\n", $1, ($1 == c ? "  (current)" : ""), ($1 == p ? "  (display default)" : "")}'
    } | choose -p "$output refresh rate at $mode") || return 0
    case "$sel" in
        '') return 0 ;;
        Automatic*)
            save_rate "$output" ''
            if auto_highest; then boost_rate "$output"
            elif [ "$pref" != - ]; then xrandr --output "$output" --mode "$mode" --rate "$pref"; fi
            [ -r "$profile" ] && save_profile
            notify "$output refresh rate is automatic again." ;;
        *)
            rate=${sel%% *}
            [ "$rate" = "$cur" ] && { save_rate "$output" "$rate"; return 0; }
            xrandr --output "$output" --mode "$mode" --rate "$rate" || { notify "Could not set $rate Hz on $output."; return 1; }
            # A rate the panel cannot really show leaves a black screen, so
            # only keep it after the user confirms they can still see.
            answer=$(printf 'Keep %s Hz\nGo back to %s Hz\n' "$rate" "$cur" | timeout 20s dmenu -i -c -l 2 -fn "$FONT" -nb "$NB" -nf "$NF" -sb "$SB" -sf "$SF" -p 'Keep this refresh rate? Reverts in 20 seconds' 2>/dev/null) || answer=
            case "$answer" in
                Keep*) save_rate "$output" "$rate"; [ -r "$profile" ] && save_profile
                       notify "$output set to $rate Hz at $mode." ;;
                *) xrandr --output "$output" --mode "$mode" --rate "$cur"
                   notify "$output is back at $cur Hz." ;;
            esac ;;
    esac
}

if [ "${1:-}" = --apply-rates ]; then apply_rates; exit 0; fi

if [ "${1:-}" = --status ]; then
    for output in $outputs; do
        want=$(fixed_mode "$output")
        set -- $(active_mode "$output")
        if [ $# -eq 0 ]; then echo "$output off"
        elif [ -n "$want" ]; then echo "$output fixed $want"
        else echo "$output automatic $1"; fi
    done
    exit 0
fi

# Back to the default: forget the fixed resolution of OUT (or of every
# output) and switch to the display's preferred mode right away.
if [ "${1:-}" = --auto-resolution ]; then
    list=${2:-$outputs}
    for output in $list; do
        [ -n "$(active_mode "$output")" ] || continue      # off stays off
        xrandr --output "$output" --auto || exit 1
    done
    if [ -r "$profile" ]; then save_profile '' "$list"; else rm -f "$pins"; fi
    for output in $list; do boost_rate "$output"; done
    apply_rates
    fit_desktop
    notify 'Resolution is automatic: it follows the display or the VM window.'
    exit 0
fi

if [ "${1:-}" = --full-range ]; then
    [ -n "$(range_outputs)" ] || { notify 'No output here has a full/limited range switch (only the Intel driver offers one).'; exit 1; }
    mkdir -p "${fullrange%/*}"
    if [ "${2:-}" = off ]; then rm -f "$fullrange"; apply_range Automatic; notify 'RGB range is automatic again.'
    else : > "$fullrange"; apply_range Full; notify 'Full-range RGB is on.'; fi
    exit 0
fi

if [ "${1:-}" = --rate ]; then
    hold_picker
    output=${2:-}
    if [ -z "$output" ]; then
        if [ "$(printf '%s\n' "$outputs" | wc -l)" -eq 1 ]; then output=$outputs
        else output=$(printf '%s\n' "$outputs" | choose -p 'Refresh rate for which display?') || exit 0; fi
    fi
    [ -n "$output" ] || exit 0
    pick_rate "$output"
    exit $?
fi

if [ "${1:-}" = --auto ]; then
    prev=
    for output in $outputs; do
        if [ -n "$prev" ]; then xrandr --output "$output" --auto --right-of "$prev" || exit 1
        else xrandr --output "$output" --auto || exit 1; fi
        prev=$output
    done
    for output in $outputs; do boost_rate "$output"; done
    apply_rates
    set_primary
    [ -e "$fullrange" ] && apply_range Full
    fit_desktop
    exit 0
fi

if [ "${1:-}" = --restore ]; then
    if [ -r "$profile" ]; then
        profile_cmds | /bin/sh 2>/dev/null
        for output in $outputs; do
            want=$(fixed_mode "$output")
            if [ -n "$want" ]; then
                # A fixed mode the display no longer lists (a VM window only
                # offers its odd size while it has it) must not leave the
                # output on a stale mode.
                set -- $(active_mode "$output")
                [ "${1:-$want}" = "$want" ] || xrandr --output "$output" --auto 2>/dev/null
                continue
            fi
            grep -q -- "--output $output " "$profile" || xrandr --output "$output" --auto 2>/dev/null || continue
            boost_rate "$output"
        done
    else
        exec "$0" --auto
    fi
    apply_rates
    set_primary
    [ -e "$fullrange" ] && apply_range Full
    fit_desktop
    exit 0
fi

hold_picker
while :; do
    action=$(printf '%s\n' 'Arrange connected displays left-to-right' 'Choose refresh rate only (keeps the resolution)' 'Choose resolution and refresh rate together' 'Turn an output off' 'Reset to automatic' 'Back' | choose -p 'Display setup') || exit 0
    case "$action" in
        'Arrange connected'*) "$0" --auto && notify 'Displays arranged left-to-right.'; exit $? ;;
        'Choose refresh rate'*) "$0" --rate ;;
        'Choose resolution'*)
            output=$(printf '%s\n' "$outputs" | choose -p 'Choose output') || continue
            [ -n "$output" ] || continue
            view=$(printf '%s\n' 'Common sizes (supported by this display)' 'All modes exposed by this display' 'Why are 5K / 8K missing?' | choose -p "$output resolutions") || continue
            case "$view" in
                'Common sizes'*) modes=$(output_modes 1) ;;
                'All modes'*) modes=$(output_modes 0) ;;
                'Why are 5K'*)
                    max_mode=$(output_modes 0 | awk '{split($1,a,"x"); if (a[1]+0 > w) {w=a[1]+0; max=$1}} END {print max}')
                    notify "$output reports modes up to $max_mode. 5K/8K appear only when the display and VM graphics adapter expose them."
                    continue ;;
                *) continue ;;
            esac
            if [ -z "$modes" ]; then
                notify "$output does not expose any named common sizes. Choose All modes to see every mode it supports."
                continue
            fi
            now=$(fixed_mode "$output")
            if [ -n "$now" ]; then now="fixed $now"; else now=automatic; fi
            selected=$({ echo "$AUTO_RES"; printf '%s\n' "$modes"; } | choose -p "$output resolution (now $now)") || continue
            [ -n "$selected" ] || continue
            if [ "$selected" = "$AUTO_RES" ]; then "$0" --auto-resolution "$output"; continue; fi
            mode=$(printf '%s\n' "$selected" | cut -d ' ' -f1)
            rate=$(printf '%s\n' "$selected" | awk -F ' @ | Hz' '{print $2}')
            xrandr --output "$output" --mode "$mode" --rate "$rate" && save_profile "$output" && save_rate "$output" "$rate" && fit_desktop && notify "$output is fixed at $mode, $rate Hz. Choose \"$AUTO_RES\" in this list to undo."
            ;;
        'Turn an output off')
            output=$(printf '%s\n' "$outputs" | choose -p 'Turn off output') || continue
            [ -n "$output" ] && xrandr --output "$output" --off && save_profile && fit_desktop && notify "$output turned off."
            ;;
        'Reset to automatic') rm -f "$profile" "$rates" "$pins"; "$0" --auto && notify 'Display profile reset.'; exit $? ;;
        *) exit 0 ;;
    esac
done
