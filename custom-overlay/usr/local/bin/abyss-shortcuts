#!/bin/sh
pause_if_terminal() {
    if [ -t 0 ]; then
        printf '\nPress Enter to close '
        IFS= read -r _
    fi
}

# Prefer the running window manager's bindings, including user changes.
if command -v abyss-key-capture >/dev/null 2>&1 && rows=$(abyss-key-capture --list 2>/dev/null) && [ -n "$rows" ]; then
    printf '%s\n\n' 'Abyss Linux — current keyboard shortcuts'
    printf '%s\n' "$rows" | awk -F '\t' '
        function chord(m,k, r) {
            if (k == "-") return "Disabled"
            r=""; if (int(m/64)%2) r=r "Super+"; if (int(m/8)%2) r=r "Alt+";
            if (int(m/4)%2) r=r "Ctrl+"; if (int(m)%2) r=r "Shift+"; return r k
        }
        $1 == "B" { printf "%-24s %s (%s)\n", chord($4,$5), $6, chord($2,$3) }
        $1 == "A" { printf "%-24s Launch %s\n", chord($3,$4), $5 }
    '
    printf '\n%s\n' 'Use Settings → Keyboard → View and edit shortcuts to make changes.'
    pause_if_terminal
    exit 0
fi

printf '%s\n' \
    'Abyss Linux — active dwm keyboard shortcuts' \
    '' \
    'Super+Return       Open st terminal' \
    'Super+Escape       Open Abyss menu' \
    'Super+grave        Toggle scratchpad terminal' \
    'Super+F1           Show this page' \
    'Super+Alt+Return   Open Alacritty, or st if Alacritty is absent' \
    'Print              Save a full-screen screenshot' \
    'Shift+Print        Select and save a screenshot area' \
    'Super+p            Run a command with dmenu' \
    'Super+s            SSH connection menu' \
    'Super+b            Open the first installed browser' \
    'Super+c            Open VS Code, or explain how to install it' \
    'Super+v            Open virt-manager, or explain how to install it' \
    'Super+Shift+l      Lock the screen' \
    'Super+Shift+b      Toggle the dwm status bar' \
    'Super+Shift+c      Close focused window' \
    'Super+Shift+q      Exit dwm' \
    '' \
    'Super+j / k        Focus next / previous window in stack' \
    'Super+Down / Up    Focus next / previous window' \
    'Super+Shift+j / k  Move focused window in stack' \
    'Super+Left / Right Move to previous / next tag' \
    'Super+Shift+Left / Right  Move window to previous / next tag' \
    'Super+h / l        Shrink / grow master area' \
    'Super+i / d        Add / remove master window' \
    'Super+Shift+Return Make focused window master' \
    'Super+Tab          View previous tag set' \
    'Super+t / f / m    Tile / floating / monocle layouts' \
    'Super+Space        Cycle layouts' \
    'Super+Shift+Space  Toggle floating for focused window' \
    'Super+0            Show all tags' \
    'Super+1…9          Switch desktop tags' \
    'Super+Shift+1…9    Move window to a tag' \
    'Super+comma / dot  Focus previous / next monitor' \
    'Super+Shift+comma / dot  Move window to previous / next monitor' \
    'Super+Alt+0        Toggle gaps; Super+Alt+Shift+0 resets gaps' \
    'Super+Alt+= / -    Increase / decrease gaps' \
    '' \
    'Super = Windows / Command key. Left Alt remains Alt by default.' \
    'Super+Escape → Settings → Display for monitors, refresh rate, OLED blanking.' \
    'Super+Escape → Install software to add apps from Void or official downloads.'

pause_if_terminal
