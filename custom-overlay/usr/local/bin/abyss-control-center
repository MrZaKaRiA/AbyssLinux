#!/bin/sh
# ==============================================================================
# abyss-control-center - the single top-right menu of Abyss Linux
#
# Opened by dwm when you click "Menu" on the status bar or press Super+Escape.
# A popup (xmenu) with nested submenus and icons, under the right end of the
# bar:
#
#   user@host · uptime                       (header: opens System info)
#   Terminal · Files · Web browser           (quick launch)
#   Applications  by category, real icons + what each app is, search, run
#   Media         images, screenshots, screen recording, play a copied URL
#   Software      install software, search Void packages, update
#   Settings      Network · Sound · Display · Keyboard
#   System        monitor, info, disks, services, power diagnostics
#   Search menu…  the same entries as a dmenu list: type to find any of them
#   Session       lock, suspend, hibernate, log out, restart, shut down
#
# Without xmenu the dmenu list is the menu: quick actions and categories
# first, a category opens its own list, typing searches every entry.
# Optional apps appear after the user installs them.
#
#   abyss-control-center            open the menu
#   abyss-control-center <action>   run one action directly
#   abyss-control-center --check    list missing optional dependencies
# ==============================================================================

PATH="/usr/local/bin:${HOME}/.local/bin:${PATH}"
# Sizes at 96 dpi, scaled by Xft.dpi (the display scale, set by abyss-scale)
DPI=$(xrdb -query 2>/dev/null | awk '$1 == "Xft.dpi:" {print int($2); exit}')
[ "${DPI:-0}" -ge 48 ] 2>/dev/null || DPI=96
BAR_H=$(( 26 * DPI / 96 ))     # dwm bar height (px) - menu opens just below it
MENU_W=$(( 260 * DPI / 96 ))   # matches xmenu.width merged by ~/.xinitrc

FONT="JetBrainsMono Nerd Font:size=10"
NB="#0d0b18" NF="#f3e8ff" SB="#a855f7" SF="#090514"

has() { command -v "$1" >/dev/null 2>&1; }

notify() {
    if has notify-send && notify-send -a "Abyss" "$1" "${2:-}"; then return; fi
    if [ -n "${DISPLAY:-}" ] && has dmenu; then
        printf '%s\n' "${2:-$1}" | dmenu_theme -p "$1" >/dev/null
    else
        echo "$1 ${2:-}" >&2
    fi
}

# Run the first available command of a list ("cmd args" strings), detached.
first() {
    for c in "$@"; do
        has "${c%% *}" && { setsid -f sh -c "$c" >/dev/null 2>&1; return 0; }
    done
    notify "Not installed" "Need one of: $*"
    return 1
}

term() {  # term "Title" command...
    t="$1"; shift
    if has st; then setsid -f st -t "$t" -e "$@" >/dev/null 2>&1
    elif has alacritty; then setsid -f alacritty -T "$t" -e "$@" >/dev/null 2>&1
    else notify "No terminal found" "Install st or alacritty"; fi
}

# Run a shell snippet in a terminal and keep the window open afterwards.
term_hold() {  # term_hold "Title" "shell code"
    term "$1" sh -c "$2; echo; printf 'Press Enter to close '; read _"
}

# Privilege helper for terminal actions: doas when configured, else sudo.
priv() {
    if has doas && [ -e /etc/doas.conf ]; then echo doas; else echo sudo; fi
}

dmenu_theme() { dmenu -i -c -l 16 -fn "$FONT" -nb "$NB" -nf "$NF" -sb "$SB" -sf "$SF" "$@"; }

confirm() {  # confirm "Restart"
    if has xmenu; then
        ans=$(printf '%s\tyes\n%s\tno\n' "  $1 now" "  Cancel" | xmenu $(menu_pos))
    else
        ans=$(printf 'No\nYes\n' | dmenu_theme -p "$1?")
        [ "$ans" = Yes ] && ans=yes
    fi
    [ "$ans" = yes ]
}

# Power actions go through abyss-power: it falls back to a clean manual
# shutdown when runit's normal path fails, and runs as root via doas/sudo
# rules that allow exactly that script.
power() {
    setsid -f sh -c "abyss-power $1 || notify-send -u critical -a Abyss 'Could not $1' 'Run: abyss-power diagnose'" >/dev/null 2>&1
}

# Width in px of the widest top-level row read from stdin (never less than
# xmenu.width). xmenu does not keep a menu placed with -p on the screen, so the
# anchor has to leave room for a long "user @ host · up ..." header.
menu_width() {
    awk -F'\t' -v dpi="$DPI" -v min="$MENU_W" '
        /^[^\t]/ { n = length($1); if (n > max) max = n }
        END { w = int((max * 8 + 32) * dpi / 96); print (w > min ? w : min) }'
}

# Where the popup opens: pinned under the right end of the bar, on the monitor
# with the pointer (else the primary one), from a click and from the keyboard
# alike. A fixed spot (-p) also fixes where submenus open (see pad_submenus).
menu_pos() {  # menu_pos [menu width in px]
    X= Y=
    has xdotool && eval "$(xdotool getmouselocation --shell 2>/dev/null)"
    # Monitor lines look like " 0: +*Virtual-1 2560/677x1600/423+0+0  Virtual-1"
    geo=$(xrandr --listactivemonitors 2>/dev/null | awk -v px="${X:-}" -v py="${Y:-}" '
        NR > 1 && split($3, g, /[\/x+]/) == 6 {
            m = g[1] " " g[5] " " g[6]
            if (px != "" && px >= g[5] && px < g[5] + g[1] && py >= g[6] && py < g[6] + g[3]) here = here ? here : m
            if ($2 ~ /\*/ && prim == "") prim = m
            if (first == "") first = m
        }
        END { print here ? here : prim ? prim : first }')
    # shellcheck disable=SC2086
    set -- "${1:-$MENU_W}" $geo
    [ $# -eq 4 ] || return
    x=$(( $3 + $2 - $1 - 8 ))
    [ "$x" -ge "$3" ] || x=$3
    bh=$(bar_height) || bh=$BAR_H
    printf -- '-p %dx%d' "$x" $(( $4 + bh + 2 ))
}

# Height of the dwm bar as drawn: dwm sizes it for the display scale it
# started with, and keeps that size after a later change of scale.
bar_height() {
    has xdotool || return 1
    xdotool search --classname '^dwm$' 2>/dev/null | while read -r b_id; do
        xdotool getwindowgeometry --shell "$b_id" 2>/dev/null
    done | awk -F= '$1 == "WIDTH" { w = $2 } $1 == "HEIGHT" && w > bw { bw = w; bh = $2 }
        END { if (bh > 0 && bh < 400) print bh; else exit 1 }'
}

# xmenu opens a submenu to the right of its parent when it fits there, else
# to the left. The menu sits at the right edge, so first-level submenus open
# to the left; a second-level one then fits on the right only by covering
# the main menu, which a narrow one (Settings › Sound) did while a wide one
# (Display) opened to the left. Padding the first label of each second-level
# submenu with spaces makes it wider than the main menu plus the gap to the
# screen edge, so every one opens to the left of its parent. The font is
# monospace: 8 px per character at 96 dpi.
pad_submenus() {  # pad_submenus MAIN_MENU_WIDTH_PX < tree
    LC_ALL=C awk -F'\t' -v OFS='\t' -v n=$(( ($1 * 96 + 8 * DPI - 1) / (8 * DPI) + 2 )) '
        { level = match($0, /[^\t]/) - 1 }
        level == 2 && prev != 2 {
            f = 3; if ($f ~ /^IMG:/) f++
            if (NF == f) $(f + 1) = $f          # the label is the output too
            s = $f; gsub(/[\200-\277]/, "", s)  # count characters, not UTF-8 bytes
            for (k = length(s); k < n; k++) $f = $f " "
        }
        { prev = level; print }'
}

header() {
    up=$(uptime -p 2>/dev/null | sed 's/^up //; s/ hours\?/h/; s/ minutes\?/m/; s/ days\?/d/; s/,//g')
    printf '  %s @ %s%s\tinfo\n' "$(id -un)" "$(cat /etc/hostname 2>/dev/null || hostname)" "${up:+  ·  up $up}"
}

# ------------------------------------------------------------------------------
# Menu tree (TAB-indented submenus, "Label<TAB>action",
# an empty line is a separator). Labels use Nerd Font glyphs.
# ------------------------------------------------------------------------------
menu_tree_raw() {
    header
    echo
    # Live ISO only: the installer goes first
    if has void-installer && grep -q 'root=live:' /proc/cmdline 2>/dev/null; then
        printf '  Install Abyss Linux\tinstall\n\n'
    fi
    cat <<'EOF'
  Terminal	term
  Files	files
  Web browser	browser

󰀻  Applications
EOF
    has abyss-apps && abyss-apps --xmenu 1
    cat <<'EOF'
	  Search all apps…	apps
	  Run a command…	run
  Media
	  Images	images
	  Take screenshot	screenshot
	  Select screenshot area	screenshot-area
	  Record screen	record-screen
	  Play clipboard URL	play-clipboard
󰏖  Software
	󰏖  Install software	software
	  Search Void packages	package-search
	󰚰  Update system	update
  Settings
	󰖩  Network
		󰖩  Connect to Wi-Fi / network	net-tui
	󰕾  Sound
		󰕾  Install audio support	install-audio
		󰕾  Volume mixer	audio-gui
		󰝝  Volume up 5%	vol-up
		󰝞  Volume down 5%	vol-down
		󰝟  Mute / unmute	vol-mute
		󰝚  Audio devices (terminal)	audio-tui
	󰍹  Display
		󰍹  __DISPLAY_RESOLUTION_LABEL__	display-follow
		󰍹  Refresh rate (keeps resolution)	display-rate
		󰍹  Resolution and refresh rate	display-gui
		󰍺  Detect displays again	display-auto
		󰇀  Pointer size	pointer-size
		󰖨  OLED screen blanking: toggle 10 min	oled-toggle
		󰖨  Wallpaper…	wallpapers
__DISPLAY_SCALE_ROWS__
	󰌌  Keyboard
		󰌌  First-run setup / keyboard layout	setup
		󰘳  __KEYBOARD_SWAP_LABEL__	kbd-swap
		󰌓  Test what keys send	kbd-test
		󰋖  Current layout and modifiers	kbd-status
		󰌌  View and edit shortcuts	shortcuts
  System
	󰄨  System monitor	monitor
	  About this computer	info
	󰋊  Disks and free space	disks
	  Running services	services
	  Power diagnostics	power-diag

  Search menu…	search

  Session
	  Lock screen	lock
	󰤄  Suspend	suspend
	󰒲  Hibernate	hibernate
	󰍃  Log out (exit dwm)	logout
	󰜉  Restart	reboot
	  Shut down	poweroff
EOF
}

menu_tree() {
    swap_label=$(abyss-keyboard --swap-label 2>/dev/null || printf 'Swap Left Alt ↔ Super (Win/Cmd)')
    # Which resolution mode is active; the entry always leads back to automatic.
    res_label=$(abyss-display --status 2>/dev/null | awk '$2 == "fixed" {printf "%s%s", sep, $3; sep = ", "}' | tr -d '|&\\')
    if [ -n "$res_label" ]; then res_label="Resolution: fixed $res_label · back to automatic (follow the display / VM window)"
    else res_label='Resolution: automatic (follow the display / VM window)'; fi
    menu_tree_raw | sed "s|__KEYBOARD_SWAP_LABEL__|$swap_label|g; s|__DISPLAY_RESOLUTION_LABEL__|$res_label|g" |
        ABYSS_SCALE_ROWS=$(scale_rows) awk '$0 == "__DISPLAY_SCALE_ROWS__" { if (ENVIRON["ABYSS_SCALE_ROWS"] != "") print ENVIRON["ABYSS_SCALE_ROWS"]; next } { print }'
}

# Display scale rows of Settings › Display: automatic first, with what it
# gives on this screen now, then the fixed choices; a check marks the saved one.
scale_rows() {
    s_auto=$(abyss-scale --default 2>/dev/null)
    s_saved=$(tr -dc 0-9 2>/dev/null < "$HOME/.config/abyss/dpi")
    s_mark=; [ -z "$s_saved" ] && s_mark='  ✓'
    printf '\t\t󰁌  Display scale: automatic%s%s\tdpi-auto\n' "${s_auto:+ (now $(( s_auto * 100 / 96 ))%)}" "$s_mark"
    for s_dpi in 96 120 144 168 192; do
        s_mark=; [ "$s_saved" = "$s_dpi" ] && s_mark='  ✓'
        printf '\t\t󰁌  Display scale: %s%%%s\tdpi-%s\n' $(( s_dpi * 100 / 96 )) "$s_mark" "$s_dpi"
    done
}

# Flatten the tree for dmenu: "Settings › Keyboard › Test what keys send<TAB>kbd-test"
menu_flat() {
    menu_tree | awk -F'\t' '
        { depth = 0; while (substr($0, depth + 1, 1) == "\t") depth++ }
        {
            n = split($0, f, "\t"); label = ""; action = ""
            for (i = 1; i <= n; i++) {
                if (f[i] == "" || f[i] ~ /^IMG:/) continue
                if (label == "") label = f[i]; else action = f[i]
            }
            if (label == "") next
            if (action == "search") next                        # this list is the search
            if (label ~ /^[^ -~]/) sub(/^[^ ]* +/, "", label)   # drop a leading glyph
            path[depth] = label
            if (action == "") {                                 # submenu header
                if (depth == 0) print label " ›\tmenu:" label   # category row
                next
            }
            out = ""
            for (i = 0; i < depth; i++) out = out path[i] " › "
            print out label "\t" action
        }'
}

# The searchable dmenu list: "Search menu…" in the popup, and the whole menu
# when xmenu is not installed.
choose_dmenu() {
    has dmenu || { notify "Abyss menu" "dmenu is not installed"; return 0; }
    flat=$(menu_flat); scope=
    while :; do
        if [ -z "$scope" ]; then
            # Quick actions and categories first (they fit on one screen),
            # then every entry, so typing finds anything.
            list=$(printf '%s\n' "$flat" | awk -F'\t' '
                $1 ~ / › ./ { deep[++n] = $0; next }
                { print }
                END { for (i = 1; i <= n; i++) print deep[i] }')
        else
            list=$(printf '%s\n' "$flat" | awk -F'\t' -v p="$scope › " '
                index($1, p) == 1 { print substr($1, length(p) + 1) "\t" $2 }
                END { print "‹ Back\tmenu:" }')
        fi
        sel=$(printf '%s\n' "$list" | cut -f1 | dmenu_theme -p "${scope:-Abyss}") || return 0
        [ -n "$sel" ] || return 0
        action=$(printf '%s\n' "$list" | awk -F'\t' -v s="$sel" '$1 == s {print $2; exit}')
        case "$action" in
            menu:*) scope=${action#menu:} ;;
            *) printf '%s\n' "$action"; return 0 ;;
        esac
    done
}

choose() {
    if has xmenu; then
        tree=$(menu_tree)
        width=$(printf '%s\n' "$tree" | menu_width)
        # shellcheck disable=SC2046
        printf '%s\n' "$tree" | pad_submenus "$width" | xmenu $(menu_pos "$width")
    else
        choose_dmenu
    fi
}

# Display scale (Xft.dpi): abyss-scale decides the automatic one and applies
# it with the menu size and the pointer; a fixed choice is kept in
# ~/.config/abyss/dpi.
apply_dpi() {
    if has abyss-scale; then abyss-scale --apply "$1"; return; fi
    printf 'Xft.dpi: %s\nxmenu.width: %s\nxmenu.height: %s\n' "$1" $((260 * $1 / 96)) $((28 * $1 / 96)) | xrdb -merge || return
    command -v abyss-cursor >/dev/null 2>&1 && abyss-cursor "$1" || :
}

set_dpi() {  # set_dpi auto|DPI
    choice=$1
    old_dpi=$DPI
    if [ "$choice" = auto ]; then
        new_dpi=$(abyss-scale --default 2>/dev/null)
        [ -n "$new_dpi" ] || new_dpi=96
    else new_dpi=$choice; fi
    pct=$(( new_dpi * 100 / 96 ))
    apply_dpi "$new_dpi" || { notify "Display scale" "Could not change X resources."; return 1; }
    # Preview first; only persist the new setting after explicit confirmation.
    # Closing the menu or letting it time out restores the previous scale.
    answer=$(printf 'Keep this scale\nRevert to previous scale\n' | timeout 20s dmenu -i -c -l 2 -fn "$FONT" -nb "$NB" -nf "$NF" -sb "$SB" -sf "$SF" -p "Keep display scale $pct%? Reverts in 20 seconds" 2>/dev/null) || answer=
    if [ "$answer" = 'Keep this scale' ]; then
        mkdir -p "$HOME/.config/abyss"
        if [ "$choice" = auto ]; then rm -f "$HOME/.config/abyss/dpi"; pct="automatic (now $pct%)"
        else printf '%s\n' "$new_dpi" > "$HOME/.config/abyss/dpi"; pct="$pct%"; fi
        notify "Display scale: $pct" "Menus and new windows use it now. Log out and back in for the bar and the apps that are open."
    else
        apply_dpi "$old_dpi"
        notify "Display scale restored" "The previous scale was kept."
    fi
}

# Pointer size: automatic follows the screen; a fixed size is kept in
# ~/.config/abyss/cursor-size and read by abyss-cursor.
set_pointer_size() {
    conf="$HOME/.config/abyss/cursor-size"
    now=$(cat "$conf" 2>/dev/null)
    auto=$(HOME=/nonexistent XCURSOR_SIZE= ABYSS_CURSOR_PRINT=1 abyss-cursor "$DPI" 2>/dev/null)
    sel=$({
        printf 'Automatic for this screen%s\n' "${auto:+ (now $auto px)}"
        for s in 24 32 48 64 96; do
            printf '%s px%s\n' "$s" "$([ "$now" = "$s" ] && printf '  (current)')"
        done
    } | dmenu_theme -p 'Pointer size') || return 0
    case "$sel" in
        '') return 0 ;;
        Automatic*) rm -f "$conf" ;;
        *) mkdir -p "${conf%/*}"; printf '%s\n' "${sel%% *}" > "$conf" ;;
    esac
    abyss-cursor
    notify "Pointer size" "The desktop pointer changes now. Windows that are already open keep the old size until they are reopened."
}

act() {
    case "$1" in
        install)      setsid -f abyss-installer >/dev/null 2>&1 ;;
        software)     setsid -f abyss-software >/dev/null 2>&1 ;;
        package-search) setsid -f abyss-software --search >/dev/null 2>&1 ;;
        setup)        setsid -f abyss-setup >/dev/null 2>&1 ;;
        term)         first "st" "alacritty" ;;
        alacritty)    if has alacritty; then first "alacritty"
                      else notify "Alacritty is not installed" "Opening the default terminal instead."; act term; fi ;;
        files)        first "thunar" "pcmanfm" "nautilus" || act lf ;;
        images)       if has nsxiv; then
                          pictures="$HOME/Pictures"
                          if has xdg-user-dir; then
                              configured=$(xdg-user-dir PICTURES 2>/dev/null)
                              [ -n "$configured" ] && [ "$configured" != "$HOME" ] && pictures=$configured
                          fi
                          mkdir -p "$pictures" || { notify "Images" "Could not open the Pictures folder."; return 1; }
                          setsid -f nsxiv -t -r "$pictures" >/dev/null 2>&1
                      else notify "Image viewer unavailable" "Update Abyss or install nsxiv from the Void repository."; fi ;;
        lf)           if has lf; then term "Files" lf; else term "Files" sh -c 'ls -la; exec bash'; fi ;;
        vim)          if has vim; then term "Editor" vim; else first "code"; fi ;;
        browser)      if has firefox || has chromium || has google-chrome-stable || has google-chrome || has brave-browser || has vivaldi; then
                          first "firefox" "chromium" "google-chrome-stable" "google-chrome" "brave-browser" "vivaldi"
                      elif has flatpak && flatpak info org.mozilla.firefox >/dev/null 2>&1; then
                          setsid -f flatpak run org.mozilla.firefox >/dev/null 2>&1
                      elif has flatpak && flatpak info com.google.Chrome >/dev/null 2>&1; then
                          setsid -f flatpak run com.google.Chrome >/dev/null 2>&1
                      else
                          notify "No browser is installed" "Open Software → Install software to add Firefox or Chrome."
                      fi ;;
        screenshot)   abyss-screenshot --screen ;;
        screenshot-area) abyss-screenshot --area ;;
        record-screen) if has ffmpeg; then term "Screen recording" abyss-record; else notify "Media tools unavailable" "Install the media tools bundle from Software."; fi ;;
        play-clipboard)
            if has xclip && has mpv; then
                url=$(xclip -selection clipboard -o 2>/dev/null)
                case "$url" in
                    https://*|http://*) setsid -f mpv -- "$url" >/dev/null 2>&1 ;;
                    *) notify "No web URL in clipboard" "Copy an HTTP or HTTPS URL first." ;;
                esac
            else notify "Media tools unavailable" "Install the media tools bundle from Software."; fi ;;
        code)         if [ -x "$HOME/.local/opt/vscode/code" ]; then
                          setsid -f "$HOME/.local/opt/vscode/code" >/dev/null 2>&1
                      elif has code; then first "code"
                      elif has flatpak && flatpak info com.visualstudio.code >/dev/null 2>&1; then setsid -f flatpak run com.visualstudio.code >/dev/null 2>&1
                      else notify "VS Code is not installed" "Open Software → Install software to add it."; fi ;;
        virt)         if has virt-manager; then first "virt-manager"
                      else notify "Virtual Machine Manager is not installed" "Open Software → Install software to add QEMU and virt-manager."; fi ;;
        apps)         setsid -f abyss-launcher drun ;;
        run)          setsid -f abyss-launcher run ;;
        search)       act "$(choose_dmenu)" ;;
        exec:*)       setsid -f sh -c "${1#exec:}" >/dev/null 2>&1 ;;
        term-exec:*)  term "${1#term-exec:}" sh -c "${1#term-exec:}" ;;

        net-tui)      has nmtui && term "Network" nmtui || notify "nmtui missing" "Install NetworkManager" ;;
        net-gui)      first "nm-connection-editor" || act net-tui ;;
        net-applet)   if pgrep -u "$(id -u)" -x nm-applet >/dev/null; then pkill -u "$(id -u)" -x nm-applet
                      else first "nm-applet"; fi ;;
        install-audio) setsid -f abyss-software --install 'pipewire wireplumber pavucontrol' >/dev/null 2>&1 ;;
        audio-gui)    first "pavucontrol" || act audio-tui ;;
        audio-tui)    if has alsamixer; then term "Audio" alsamixer
                      else term_hold "Audio" 'wpctl status'; fi ;;
        vol-up)       if has wpctl; then wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; else notify "Audio is not installed" "Install PipeWire from Install software."; fi ;;
        vol-down)     if has wpctl; then wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; else notify "Audio is not installed" "Install PipeWire from Install software."; fi ;;
        vol-mute)     if has wpctl; then wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; else notify "Audio is not installed" "Install PipeWire from Install software."; fi ;;
        display-gui)  abyss-display ;;
        display-rate) abyss-display --rate ;;
        display-follow) abyss-display --auto-resolution ;;
        display-auto) abyss-display --auto && notify "Displays" "Outputs re-detected" ;;
        pointer-size) if has abyss-cursor; then set_pointer_size
                      else notify "Pointer size" "Update Abyss to get the pointer size setting."; fi ;;
        oled-toggle)  conf="$HOME/.config/abyss/oled-blanking"; mkdir -p "${conf%/*}"
                      if [ "$(cat "$conf" 2>/dev/null)" = 1 ]; then
                          echo 0 > "$conf"; xset s off; xset -dpms; notify "OLED blanking off" "The display will stay on while idle."
                      else
                          echo 1 > "$conf"; xset s 600 600; xset +dpms; xset dpms 600 600 600
                          notify "OLED blanking on" "The screen blanks after 10 minutes idle; move the mouse or press a key to wake it."
                      fi ;;
        dpi-auto|dpi-96|dpi-120|dpi-144|dpi-168|dpi-192) set_dpi "${1#dpi-}" ;;
        kbd-toggle)   abyss-keyboard --toggle ;;
        kbd-swap)     abyss-keyboard --swap-super ;;
        kbd-test)     abyss-keyboard --test ;;
        kbd-status)   notify "Keyboard" "$(abyss-keyboard --status 2>&1)" ;;
        wallpapers)   if has abyss-wallpapers; then abyss-wallpapers
                      else notify "Wallpaper" "Update Abyss to get the wallpaper manager."; fi ;;
        wallpaper)    abyss-wallpaper ;;
        wallpaper-abyss|wallpaper-none) abyss-wallpaper "${1#wallpaper-}" ;;
        gtk-settings) first "lxappearance" "nwg-look" || notify "Abyss theme" "GTK theme Abyss and icon theme Abyss are set in /etc/xdg/gtk-3.0/settings.ini" ;;

        monitor)      if has btop; then term "System monitor" btop
                      elif has htop; then term "System monitor" htop
                      else term "System monitor" top; fi ;;
        info)         term_hold "About this computer" 'fastfetch 2>/dev/null || uname -a' ;;
        update)       p=$(priv)   # one privileged shell: the password is asked once
                      term_hold "Abyss System Update" "$p sh -c 'xbps-install -Su && xbps-remove -Oo' && echo 'System is up to date.'" ;;
        disks)        term_hold "Disks" 'df -h -x tmpfs -x devtmpfs -x efivarfs; echo; lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINTS' ;;
        services)     term_hold "Services" 'sv status /var/service/* 2>/dev/null | sed "s|/var/service/||"' ;;
        power-diag)   term_hold "Power diagnostics" 'abyss-power diagnose' ;;
        ssh)          first "dmenu-ssh" ;;
        shortcuts)    setsid -f abyss-shortcut-editor >/dev/null 2>&1 ;;

        lock)         first "slock" ;;
        suspend)      power suspend ;;
        hibernate)    power hibernate ;;
        logout)       confirm "Log out" && pkill -u "$(id -u)" -x dwm ;;
        reboot)       confirm "Restart" && power reboot ;;
        poweroff)     confirm "Shut down" && power poweroff ;;

        ""|no|yes)    ;;
        *)            notify "Abyss menu" "Unknown action: $1" ;;
    esac
}

check() {
    missing=""
    for c in xmenu dmenu st dwm slock xrandr setxkbmap xbps-query xbps-install abyss-power abyss-software abyss-setup abyss-display; do
        has "$c" || missing="$missing $c"
    done
    if [ -n "$missing" ]; then echo "missing:$missing"; return 1; fi
    echo "all dependencies present"
}

case "${1:-}" in
    --check) check ;;
    "")      act "$(choose)" ;;
    *)       act "$1" ;;
esac
