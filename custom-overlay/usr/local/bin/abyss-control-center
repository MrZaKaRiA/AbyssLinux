#!/bin/sh
# ==============================================================================
# abyss-control-center - the single top-right menu of Abyss Linux
#
# Opened by dwm when you click the status bar or press Super+Escape. The
# dmenu-first tree keeps the installed desktop small:
#
#   user@host · uptime                       (header: opens System info)
#   Terminal · Files · Web browser           (quick launch)
#   Applications  by category, real icons + what each app is, search, run
#   Settings      Network · Sound · Display · Keyboard · Appearance
#   System        monitor, info, update, disks, services, power diagnostics
#   Session       lock, suspend, hibernate, log out, restart, shut down
#
# Uses the included dmenu and Abyss shell scripts; optional apps appear after
# the user installs them.
#
#   abyss-control-center            open the menu
#   abyss-control-center <action>   run one action directly
#   abyss-control-center --check    list missing optional dependencies
# ==============================================================================

PATH="/usr/local/bin:${HOME}/.local/bin:${PATH}"
WALLPAPER=/usr/share/backgrounds/abyss/abyss-wallpaper.jpg
# Sizes at 96 dpi, scaled by Xft.dpi (set by ~/.xinitrc for HiDPI screens)
DPI=$(xrdb -query 2>/dev/null | awk '$1 == "Xft.dpi:" {print int($2); exit}')
[ "${DPI:-0}" -ge 48 ] 2>/dev/null || DPI=96
BAR_H=$(( 26 * DPI / 96 ))     # dwm bar height (px) - menu opens just below it
MENU_W=$(( 260 * DPI / 96 ))   # matches xmenu.width merged by ~/.xinitrc

FONT="JetBrainsMono Nerd Font:size=10"
NB="#0d0b18" NF="#f3e8ff" SB="#a855f7" SF="#090514"

has() { command -v "$1" >/dev/null 2>&1; }

notify() {
    if has notify-send && notify-send -a "Abyss" "$1" "${2:-}"; then return; fi
    if [ -n "${DISPLAY:-}" ] && has dmenu; then
        printf '%s\n' "${2:-$1}" | dmenu_theme -p "$1" >/dev/null
    else
        echo "$1 ${2:-}" >&2
    fi
}

# Run the first available command of a list ("cmd args" strings), detached.
first() {
    for c in "$@"; do
        has "${c%% *}" && { setsid -f sh -c "$c" >/dev/null 2>&1; return 0; }
    done
    notify "Not installed" "Need one of: $*"
    return 1
}

term() {  # term "Title" command...
    t="$1"; shift
    if has st; then setsid -f st -t "$t" -e "$@" >/dev/null 2>&1
    elif has alacritty; then setsid -f alacritty -T "$t" -e "$@" >/dev/null 2>&1
    else notify "No terminal found" "Install st or alacritty"; fi
}

# Run a shell snippet in a terminal and keep the window open afterwards.
term_hold() {  # term_hold "Title" "shell code"
    term "$1" sh -c "$2; echo; printf 'Press Enter to close '; read _"
}

# Privilege helper for terminal actions: doas when configured, else sudo.
priv() {
    if has doas && [ -e /etc/doas.conf ]; then echo doas; else echo sudo; fi
}

dmenu_theme() { dmenu -i -c -l 16 -fn "$FONT" -nb "$NB" -nf "$NF" -sb "$SB" -sf "$SF" "$@"; }

confirm() {  # confirm "Restart"
    if has xmenu; then
        ans=$(printf '%s\tyes\n%s\tno\n' "  $1 now" "  Cancel" | xmenu $(menu_pos))
    else
        ans=$(printf 'No\nYes\n' | dmenu_theme -p "$1?")
        [ "$ans" = Yes ] && ans=yes
    fi
    [ "$ans" = yes ]
}

# Power actions go through abyss-power: it falls back to a clean manual
# shutdown when runit's normal path fails, and runs as root via doas/sudo
# rules that allow exactly that script.
power() {
    setsid -f sh -c "abyss-power $1 || notify-send -u critical -a Abyss 'Could not $1' 'Run: abyss-power diagnose'" >/dev/null 2>&1
}

# Top-right anchor for optional xmenu installations; dmenu does not use this.
menu_pos() {
    if has xdotool; then
        eval "$(xdotool getmouselocation --shell 2>/dev/null)"
        [ "${Y:-999}" -le "$BAR_H" ] && return
    fi
    geo=$(xrandr --listactivemonitors 2>/dev/null | awk 'NR>1 && /\*/ {print $3; exit}')
    [ -n "$geo" ] || geo=$(xrandr --listactivemonitors 2>/dev/null | awk 'NR==2 {print $3}')
    # geo looks like 2560/677x1600/423+0+0
    w=$(echo "$geo" | sed -n 's|^\([0-9]*\)/.*|\1|p')
    ox=$(echo "$geo" | sed -n 's|.*+\([0-9]*\)+[0-9]*$|\1|p')
    [ -n "$w" ] || return
    printf -- '-p %dx%d' $(( ${ox:-0} + w - MENU_W - 8 )) $(( BAR_H + 2 ))
}

header() {
    up=$(uptime -p 2>/dev/null | sed 's/^up //; s/ hours\?/h/; s/ minutes\?/m/; s/ days\?/d/; s/,//g')
    printf '  %s @ %s%s\tinfo\n' "$(id -un)" "$(cat /etc/hostname 2>/dev/null || hostname)" "${up:+  ·  up $up}"
}

# ------------------------------------------------------------------------------
# Menu tree (TAB-indented submenus, "Label<TAB>action",
# an empty line is a separator). Labels use Nerd Font glyphs.
# ------------------------------------------------------------------------------
menu_tree_raw() {
    header
    echo
    # Live ISO only: the installer goes first
    if has void-installer && grep -q 'root=live:' /proc/cmdline 2>/dev/null; then
        printf '  Install Abyss Linux\tinstall\n\n'
    fi
    cat <<'EOF'
  Terminal	term
  Files	files
  Images	images
  Web browser	browser
  Take screenshot	screenshot
  Select screenshot area	screenshot-area
󰀻  Applications
EOF
    has abyss-apps && abyss-apps --xmenu 1
    cat <<'EOF'
	  Search all apps…	apps
	  Run a command…	run

󰏖  Software
	󰏖  Install software	software
	  Search Void packages	package-search
	󰚰  Update system	update

  Settings
	󰖩  Network
		󰖩  Connect to Wi-Fi / network	net-tui
	󰕾  Sound
		󰕾  Install audio support	install-audio
		󰕾  Volume mixer	audio-gui
		󰝝  Volume up 5%	vol-up
		󰝞  Volume down 5%	vol-down
		󰝟  Mute / unmute	vol-mute
		󰝚  Audio devices (terminal)	audio-tui
	󰍹  Display
		󰍹  Resolution and refresh rate	display-gui
		󰍺  Detect displays again	display-auto
		󰖨  OLED screen blanking: toggle 10 min	oled-toggle
		  Text size: automatic (recommended)	dpi-auto
		  Text size: 100% (96 DPI)	dpi-96
		  Text size: 150% (144 DPI)	dpi-144
		  Text size: 200% (192 DPI)	dpi-192
	󰌌  Keyboard
		󰌌  First-run setup / keyboard layout	setup
		󰘳  __KEYBOARD_SWAP_LABEL__	kbd-swap
		󰌓  Test what keys send	kbd-test
		󰋖  Current layout and modifiers	kbd-status
		󰌌  View and edit shortcuts	shortcuts
  System
	󰄨  System monitor	monitor
	  About this computer	info
	󰋊  Disks and free space	disks
	  Running services	services
	  Power diagnostics	power-diag

  Session
	  Lock screen	lock
	󰤄  Suspend	suspend
	󰒲  Hibernate	hibernate
	󰍃  Log out (exit dwm)	logout
	󰜉  Restart	reboot
	  Shut down	poweroff
EOF
}

menu_tree() {
    swap_label=$(abyss-keyboard --swap-label 2>/dev/null || printf 'Swap Left Alt ↔ Super (Win/Cmd)')
    menu_tree_raw | sed "s|__KEYBOARD_SWAP_LABEL__|$swap_label|g"
}

# Flatten the tree for dmenu: "Settings › Keyboard › Test what keys send<TAB>kbd-test"
menu_flat() {
    menu_tree | awk -F'\t' '
        { depth = 0; while (substr($0, depth + 1, 1) == "\t") depth++ }
        {
            n = split($0, f, "\t"); label = ""; action = ""
            for (i = 1; i <= n; i++) {
                if (f[i] == "" || f[i] ~ /^IMG:/) continue
                if (label == "") label = f[i]; else action = f[i]
            }
            if (label == "") next
            if (label ~ /^[^ -~]/) sub(/^[^ ]* +/, "", label)   # drop a leading glyph
            path[depth] = label
            if (action == "") next                              # submenu header
            out = ""
            for (i = 0; i < depth; i++) out = out path[i] " › "
            print out label "\t" action
        }'
}

choose() {
    if has xmenu; then
        # shellcheck disable=SC2046
        menu_tree | xmenu $(menu_pos)
    elif has dmenu; then
        sel=$(menu_flat | cut -f1 | dmenu_theme -p "Abyss")
        [ -n "$sel" ] && menu_flat | awk -F'\t' -v s="$sel" '$1 == s {print $2; exit}'
    else
        notify "Abyss menu" "dmenu is not installed"
    fi
}

automatic_dpi() {
    apple_vm=
    grep -qs '^Apple' /sys/class/dmi/id/sys_vendor && apple_vm=1
    grep -qsx '0x106b' /sys/bus/pci/devices/*/subsystem_vendor && apple_vm=1
    h=$(xrandr --query 2>/dev/null | awk '$2 == "connected" {for(i=3;i<=NF;i++) if ($i ~ /^[0-9]+x[0-9]+[+-]/) {v=$i; sub(/[+-].*/, "", v); split(v,a,"x"); if (a[2] > h) h=a[2]}} END {print h+0}')
    if [ -n "$apple_vm" ] || [ "${h:-0}" -ge 1700 ]; then echo 192
    elif [ "${h:-0}" -ge 1300 ]; then echo 144
    else echo 96; fi
}

apply_dpi() {
    printf 'Xft.dpi: %s\nxmenu.width: %s\nxmenu.height: %s\n' "$1" $((260 * $1 / 96)) $((28 * $1 / 96)) | xrdb -merge
}

set_dpi() {
    choice=$1
    old_dpi=$DPI
    [ "$choice" = auto ] && new_dpi=$(automatic_dpi) || new_dpi=$choice
    apply_dpi "$new_dpi" || { notify "Text size" "Could not change X resources."; return 1; }
    # Preview first; only persist the new setting after explicit confirmation.
    # Closing the menu or letting it time out restores the previous DPI.
    answer=$(printf 'Keep this size\nRevert to previous size\n' | timeout 20s dmenu -i -c -l 2 -fn "$FONT" -nb "$NB" -nf "$NF" -sb "$SB" -sf "$SF" -p 'Keep text size? Reverts in 20 seconds' 2>/dev/null) || answer=
    if [ "$answer" = 'Keep this size' ]; then
        mkdir -p "$HOME/.config/abyss"
        if [ "$choice" = auto ]; then rm -f "$HOME/.config/abyss/dpi"
        else printf '%s\n' "$new_dpi" > "$HOME/.config/abyss/dpi"; fi
        notify "Text size saved" "New windows use the new size. Log out and back in for the bar and open apps."
    else
        apply_dpi "$old_dpi"
        notify "Text size restored" "The previous size was kept."
    fi
}

act() {
    case "$1" in
        install)      setsid -f abyss-installer >/dev/null 2>&1 ;;
        software)     setsid -f abyss-software >/dev/null 2>&1 ;;
        package-search) setsid -f abyss-software --search >/dev/null 2>&1 ;;
        setup)        setsid -f abyss-setup >/dev/null 2>&1 ;;
        term)         first "st" "alacritty" ;;
        alacritty)    if has alacritty; then first "alacritty"
                      else notify "Alacritty is not installed" "Opening the default terminal instead."; act term; fi ;;
        files)        first "thunar" "pcmanfm" "nautilus" || act lf ;;
        images)       if has nsxiv; then
                          pictures="$HOME/Pictures"
                          if has xdg-user-dir; then
                              configured=$(xdg-user-dir PICTURES 2>/dev/null)
                              [ -n "$configured" ] && [ "$configured" != "$HOME" ] && pictures=$configured
                          fi
                          mkdir -p "$pictures" || { notify "Images" "Could not open the Pictures folder."; return 1; }
                          setsid -f nsxiv -t -r "$pictures" >/dev/null 2>&1
                      else notify "Image viewer unavailable" "Update Abyss or install nsxiv from the Void repository."; fi ;;
        lf)           if has lf; then term "Files" lf; else term "Files" sh -c 'ls -la; exec bash'; fi ;;
        vim)          if has vim; then term "Editor" vim; else first "code"; fi ;;
        browser)      if has firefox || has chromium || has google-chrome-stable || has google-chrome || has brave-browser || has vivaldi; then
                          first "firefox" "chromium" "google-chrome-stable" "google-chrome" "brave-browser" "vivaldi"
                      elif has flatpak && flatpak info org.mozilla.firefox >/dev/null 2>&1; then
                          setsid -f flatpak run org.mozilla.firefox >/dev/null 2>&1
                      elif has flatpak && flatpak info com.google.Chrome >/dev/null 2>&1; then
                          setsid -f flatpak run com.google.Chrome >/dev/null 2>&1
                      else
                          notify "No browser is installed" "Open Software → Install software to add Firefox or Chrome."
                      fi ;;
        screenshot)   abyss-screenshot --screen ;;
        screenshot-area) abyss-screenshot --area ;;
        code)         if [ -x "$HOME/.local/opt/vscode/code" ]; then
                          setsid -f "$HOME/.local/opt/vscode/code" >/dev/null 2>&1
                      elif has code; then first "code"
                      elif has flatpak && flatpak info com.visualstudio.code >/dev/null 2>&1; then setsid -f flatpak run com.visualstudio.code >/dev/null 2>&1
                      else notify "VS Code is not installed" "Open Software → Install software to add it."; fi ;;
        virt)         if has virt-manager; then first "virt-manager"
                      else notify "Virtual Machine Manager is not installed" "Open Software → Install software to add QEMU and virt-manager."; fi ;;
        apps)         setsid -f abyss-launcher drun ;;
        run)          setsid -f abyss-launcher run ;;
        exec:*)       setsid -f sh -c "${1#exec:}" >/dev/null 2>&1 ;;
        term-exec:*)  term "${1#term-exec:}" sh -c "${1#term-exec:}" ;;

        net-tui)      has nmtui && term "Network" nmtui || notify "nmtui missing" "Install NetworkManager" ;;
        net-gui)      first "nm-connection-editor" || act net-tui ;;
        net-applet)   if pgrep -u "$(id -u)" -x nm-applet >/dev/null; then pkill -u "$(id -u)" -x nm-applet
                      else first "nm-applet"; fi ;;
        install-audio) setsid -f abyss-software --install 'pipewire pipewire-pulse wireplumber pavucontrol' >/dev/null 2>&1 ;;
        audio-gui)    first "pavucontrol" || act audio-tui ;;
        audio-tui)    if has alsamixer; then term "Audio" alsamixer
                      else term_hold "Audio" 'wpctl status'; fi ;;
        vol-up)       if has wpctl; then wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; else notify "Audio is not installed" "Install PipeWire from Install software."; fi ;;
        vol-down)     if has wpctl; then wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; else notify "Audio is not installed" "Install PipeWire from Install software."; fi ;;
        vol-mute)     if has wpctl; then wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; else notify "Audio is not installed" "Install PipeWire from Install software."; fi ;;
        display-gui)  abyss-display ;;
        display-auto) xrandr --auto && notify "Displays" "Outputs re-detected" ;;
        oled-toggle)  conf="$HOME/.config/abyss/oled-blanking"; mkdir -p "${conf%/*}"
                      if [ "$(cat "$conf" 2>/dev/null)" = 1 ]; then
                          echo 0 > "$conf"; xset s off; xset -dpms; notify "OLED blanking off" "The display will stay on while idle."
                      else
                          echo 1 > "$conf"; xset s 600 600; xset +dpms; xset dpms 600 600 600
                          notify "OLED blanking on" "The screen blanks after 10 minutes idle; move the mouse or press a key to wake it."
                      fi ;;
        dpi-auto|dpi-96|dpi-144|dpi-192) set_dpi "${1#dpi-}" ;;
        kbd-toggle)   abyss-keyboard --toggle ;;
        kbd-swap)     abyss-keyboard --swap-super ;;
        kbd-test)     abyss-keyboard --test ;;
        kbd-status)   notify "Keyboard" "$(abyss-keyboard --status 2>&1)" ;;
        wallpaper)    [ -f "$WALLPAPER" ] && feh --no-fehbg --bg-fill "$WALLPAPER" ;;
        gtk-settings) first "lxappearance" "nwg-look" || notify "Abyss theme" "GTK theme Abyss and icon theme Abyss are set in /etc/xdg/gtk-3.0/settings.ini" ;;

        monitor)      if has btop; then term "System monitor" btop
                      elif has htop; then term "System monitor" htop
                      else term "System monitor" top; fi ;;
        info)         term_hold "About this computer" 'fastfetch 2>/dev/null || uname -a' ;;
        update)       p=$(priv)
                      term_hold "Abyss System Update" "$p xbps-install -Su && $p xbps-remove -Oo && echo 'System is up to date.'" ;;
        disks)        term_hold "Disks" 'df -h -x tmpfs -x devtmpfs -x efivarfs; echo; lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINTS' ;;
        services)     term_hold "Services" 'sv status /var/service/* 2>/dev/null | sed "s|/var/service/||"' ;;
        power-diag)   term_hold "Power diagnostics" 'abyss-power diagnose' ;;
        ssh)          first "dmenu-ssh" ;;
        shortcuts)    setsid -f abyss-shortcut-editor >/dev/null 2>&1 ;;

        lock)         first "slock" ;;
        suspend)      power suspend ;;
        hibernate)    power hibernate ;;
        logout)       confirm "Log out" && pkill -u "$(id -u)" -x dwm ;;
        reboot)       confirm "Restart" && power reboot ;;
        poweroff)     confirm "Shut down" && power poweroff ;;

        ""|no|yes)    ;;
        *)            notify "Abyss menu" "Unknown action: $1" ;;
    esac
}

check() {
    missing=""
    for c in dmenu st dwm slock xrandr setxkbmap xbps-query xbps-install abyss-power abyss-software abyss-setup abyss-display; do
        has "$c" || missing="$missing $c"
    done
    if [ -n "$missing" ]; then echo "missing:$missing"; return 1; fi
    echo "all dependencies present"
}

case "${1:-}" in
    --check) check ;;
    "")      act "$(choose)" ;;
    *)       act "$1" ;;
esac
