#!/bin/sh
# Minimal on-demand software browser for Void Linux.

# the Abyss commands and the user's own, without putting them before a PATH
# that already has them (tests run stubs first)
for d in "$HOME/.local/bin" /usr/local/bin; do
    case ":$PATH:" in *":$d:"*) ;; *) PATH="$d:$PATH" ;; esac
done
NB='#0d0b18' NF='#f3e8ff' SB='#a855f7' SF='#090514'
FONT='JetBrainsMono Nerd Font:size=10'

has() { command -v "$1" >/dev/null 2>&1; }
choose() { dmenu -i -c -l 13 -fn "$FONT" -nb "$NB" -nf "$NF" -sb "$SB" -sf "$SF" "$@"; }
term() { setsid -f st -t "$1" -e sh -c "$2; echo; printf 'Press Enter to close '; read _" >/dev/null 2>&1; }
priv() { abyss-priv "$@"; }
note() {
    if [ -n "${ABYSS_IN_TERMINAL:-}" ]; then printf '%s: %s\n' "$1" "${2:-}"
    elif has notify-send; then notify-send -a Abyss "$1" "${2:-}"
    else printf '%s — %s\n' "$1" "${2:-}" | choose -p 'Abyss'; fi
}

# This script, by absolute path, so the install terminal can run its helper.
SELF=$0
case $SELF in */*) ;; *) SELF=$(command -v "$SELF" 2>/dev/null || printf '%s' "$SELF") ;; esac
case $SELF in /*) ;; *) SELF="$PWD/$SELF" ;; esac
BIG_DOWNLOAD=$((500 * 1024 * 1024))   # ask before downloads larger than this

# The Void architecture of this machine (x86_64, aarch64, ...), without -musl.
machine_arch() {
    a=$(xbps-uhelper arch 2>/dev/null)
    [ -n "$a" ] || a=$(uname -m)
    printf '%s\n' "${a%-musl}"
}

# Is an entry for ARCHES (empty or "all", or a comma list) offered on ARCH?
offered_on() {
    case ${2:-all} in all) return 0 ;; esac
    case ",$2," in *",$1,"*) return 0 ;; esac
    return 1
}

# The packages of a bundle that exist on ARCH. A word may name the
# architectures it exists on: foo@x86_64 is installed only on x86_64.
arch_packages() {  # arch_packages ARCH "word..."
    out=
    for word in $2; do
        case $word in *@*) offered_on "$1" "${word#*@}" || continue ;; esac
        out="$out ${word%%@*}"
    done
    printf '%s\n' "${out# }"
}

valid_names() { case $1 in ''|*[!A-Za-z0-9._+\ -]*) return 1 ;; esac; }

xbps_busy() {
    pgrep -x xbps-install >/dev/null 2>&1 || pgrep -x xbps-remove >/dev/null 2>&1 ||
        pgrep -x xbps-reconfigure >/dev/null 2>&1
}

wait_for_xbps() {
    xbps_busy || return 0
    echo 'Another install or update is running; this one will start when it finishes.'
    echo '(Press Ctrl+C to cancel.)'
    while xbps_busy; do sleep "${ABYSS_LOCK_POLL:-2}"; done
    echo 'The other one has finished; continuing.'
}

explain_sync_failure() {  # explain_sync_failure LOG
    echo
    if grep -qiE 'resolv|name or service|name resolution' "$1"; then
        echo 'The package servers could not be found: this computer cannot look up'
        echo 'their names (DNS). Check that you are connected to the network, or wait'
        echo 'a minute if it has only just connected.'
    elif grep -qiE 'timed out|timeout|refused|unreachable|no route|connect' "$1"; then
        echo 'The package servers could not be reached. Check your network connection.'
    else
        echo 'The package lists could not be updated (see the messages above).'
    fi
    echo 'To retry, open Install software again, or run "update" in a terminal.'
}

# Package lists this script synced less than SYNC_FRESH_MIN minutes ago are
# used as they are, so installing several things in a row downloads them
# once. The stamp lives in /run (root only, empty after a reboot). xbps
# leaves an unchanged repodata file untouched, so its own times cannot tell.
SYNC_STAMP=${ABYSS_SYNC_STAMP:-/run/abyss-software.synced}
SYNC_FRESH_MIN=${ABYSS_SYNC_FRESH_MIN:-30}

# Are the package lists fresh? Not when a repository has none on disk
# (xbps-query -L counts -1) or the repository configuration changed since.
repos_fresh() {
    [ "$SYNC_FRESH_MIN" -gt 0 ] 2>/dev/null && [ -f "$SYNC_STAMP" ] || return 1
    [ -n "$(find "$SYNC_STAMP" -mmin "-$SYNC_FRESH_MIN" 2>/dev/null)" ] || return 1
    [ -z "$(find /etc/xbps.d /usr/share/xbps.d -newer "$SYNC_STAMP" 2>/dev/null)" ] || return 1
    lists=$(xbps-query -L 2>/dev/null) || return 1
    [ -n "$lists" ] && ! printf '%s\n' "$lists" | grep -q '^[[:space:]]*-1[[:space:]]'
}

# Update the package lists, retrying network failures before giving up.
# Returns 0 on success, 1 when a repository stayed unreachable, 2 when the
# privilege tool refused (wrong password).
sync_repos() {
    tries=${ABYSS_SYNC_TRIES:-3} n=1
    log=$(mktemp "${TMPDIR:-/tmp}/abyss-sync.XXXXXX") || return 1
    while :; do
        echo "Updating package lists (attempt $n of $tries)..."
        # Stream the output: xbps may ask to import a repository key.
        { abyss-priv xbps-install -S; echo $? >"$log.rc"; } 2>&1 | tee "$log"
        rc=$(cat "$log.rc" 2>/dev/null || echo 1); rm -f "$log.rc"
        if [ "$rc" -eq 0 ] && ! grep -q 'ERROR' "$log"; then
            rm -f "$log"; : > "$SYNC_STAMP" 2>/dev/null; return 0
        fi
        if grep -qiE 'authentication failed|incorrect password|not permitted|doas or sudo' "$log"; then
            rm -f "$log"; echo; echo 'Installing software needs your password (doas or sudo).'; return 2
        fi
        [ "$n" -lt "$tries" ] || break
        pause=${ABYSS_RETRY_PAUSE:-5}
        echo "A package server could not be reached; trying again in ${pause}s..."
        sleep "$pause"
        n=$((n + 1))
    done
    explain_sync_failure "$log"
    rm -f "$log"
    return 1
}

# "DOWNLOAD INSTALLED" bytes for installing the packages, from a dry run with
# the package lists already on disk (no root needed). Fails if xbps cannot.
dry_run_size() {
    out=$(xbps-install -n "$@" 2>/dev/null) || return 1
    printf '%s\n' "$out" | awk '$2 ~ /^(install|update|reinstall|downgrade)$/ { i += $5; d += $6 }
        END { printf "%.0f %.0f\n", d, i }'
}

human() {
    awk -v b="$1" 'BEGIN { if (b >= 1073741824) printf "%.1f GB", b / 1073741824;
        else if (b >= 1048576) printf "%.0f MB", b / 1048576; else printf "%.0f KB", b / 1024 }'
}

# Runs inside the install terminal (or from a shell: abyss-software
# --run-install [--yes] PKG...). Never stops a bundle silently: missing
# packages are reported by name and the rest is still installed.
run_install() {
    # Ask for the password once: run the whole install as root. The marker
    # file tells a refused password apart from a failed install.
    if [ "${1:-}" = --elevated ]; then
        rm -f "$2"; shift 2
    elif [ "$(id -u)" -ne 0 ]; then
        mark=$(mktemp "${TMPDIR:-/tmp}/abyss-elevate.XXXXXX") || return 1
        echo 'Changing installed software needs administrator rights.'
        abyss-priv /bin/sh "$SELF" --run-install --elevated "$mark" "$@"; rc=$?
        if [ -e "$mark" ]; then
            rm -f "$mark"; echo; echo 'Installing software needs your password (doas or sudo). Nothing was installed.'
            return 1
        fi
        return "$rc"
    fi
    yes= update=
    while :; do
        case ${1:-} in
            --yes) yes=-y; shift ;;
            --update) update=-u; shift ;;   # bring installed packages up to date
            *) break ;;
        esac
    done
    arch=$(machine_arch)
    wait_for_xbps
    # Installing reuses lists synced moments ago; updating always syncs.
    if [ -z "$update" ] && repos_fresh; then
        echo "Package lists are up to date (updated less than $SYNC_FRESH_MIN minutes ago)."
        rc=0
    else
        sync_repos; rc=$?
    fi
    [ "$rc" -eq 2 ] && return 1
    [ "$rc" -eq 0 ] || echo 'Continuing with the package lists already on this computer.'
    ok= missing= broken=
    for pkg; do
        if xbps-query -R "$pkg" >/dev/null 2>&1; then ok="$ok $pkg"; else missing="$missing $pkg"; fi
    done
    if [ -n "$ok" ] && ! xbps-install -n $update $ok >/dev/null 2>&1; then
        keep=
        for pkg in $ok; do
            if xbps-install -n $update "$pkg" >/dev/null 2>&1; then keep="$keep $pkg"; else broken="$broken $pkg"; fi
        done
        ok=$keep
    fi
    status=1
    if [ -n "$ok" ]; then
        if sizes=$(dry_run_size $update $ok); then
            set -- $sizes
            [ "$1" -eq 0 ] || { echo; echo "Download: $(human "$1"), disk space needed: $(human "$2")"; }
        fi
        if [ -n "$update" ]; then echo "Updating:$ok"; else echo "Installing:$ok"; fi
        wait_for_xbps
        abyss-priv xbps-install $yes $update $ok; status=$?
        # drop replaced package versions from the cache (says what it freed)
        [ "$status" -ne 0 ] || [ ! -x "${ABYSS_DISK_CARE:=/usr/libexec/abyss-desktop/disk-care}" ] || "$ABYSS_DISK_CARE" clean-cache
    fi
    # Trust the package database, not the exit status: answering "n" at the
    # xbps prompt exits 0 without installing anything.
    done_= notdone=
    for pkg in $ok; do
        if xbps-query "$pkg" >/dev/null 2>&1; then done_="$done_ $pkg"; else notdone="$notdone $pkg"; fi
    done
    echo
    echo '==================== Summary ===================='
    if [ -n "$done_" ]; then
        if [ -n "$update" ]; then echo "Up to date:$done_"; else echo "Installed:$done_"; fi
    fi
    if [ -n "$notdone" ] && [ "$status" -eq 0 ]; then
        echo "Not installed (cancelled):$notdone"
    elif [ -n "$notdone" ] || [ "$status" -ne 0 ]; then
        echo "Not installed:$notdone (xbps-install exit $status; see the messages above)"
    fi
    [ -z "$missing" ] || echo "Not available for $arch in the enabled repositories:$missing"
    [ -z "$broken" ] || echo "Cannot be installed on this system (dependency problem):$broken"
    [ -n "$ok" ] || echo 'Nothing was installed.'
    [ "$rc" -eq 0 ] || echo 'Note: the package lists could not be updated, so these results may be out of date.'
    [ -n "$ok" ] && [ "$status" -eq 0 ] && [ -z "$missing$broken$notdone" ]
}

install_packages() {  # install_packages "word..." (words may carry @arch)
    arch=$(machine_arch)
    packages=$(arch_packages "$arch" "$1")
    if ! valid_names "$packages"; then
        note 'Nothing to install' "None of these packages is offered for $arch: $1"
        return 1
    fi
    if sizes=$(dry_run_size $packages); then
        set -- $sizes
        if [ "$1" -ge "$BIG_DOWNLOAD" ]; then
            answer=$(printf 'Install (downloads %s, needs %s of disk)\nCancel\n' "$(human "$1")" "$(human "$2")" |
                choose -p 'Large download')
            case $answer in Install*) ;; *) return 1 ;; esac
        fi
    fi
    xbps_busy && note 'Another install or update is running' 'This one will start when it finishes.'
    term 'Install software' "/bin/sh '$SELF' --run-install $packages"
}

search_packages() {
    query=$(printf '' | choose -p 'Search Void packages') || return
    [ -n "$query" ] || return
    # Lines are "[-] name-version_revision  description"; the version never
    # contains a dash, so the name is everything before the last one.
    results=$(xbps-query -Rs "$query" 2>/dev/null | awk '
        { line=$0; sub(/^\[[^]]+\][[:space:]]*/, "", line); $0=line; pkg=$1; sub(/-[^-]*$/, "", pkg); $1=""; sub(/^[[:space:]]+/, ""); if (pkg != "") printf "%s — %s\n", pkg, $0 }
    ' | sort -u)
    [ -n "$results" ] || { note 'No packages found' "$query"; return; }
    choice=$(printf '%s\n' "$results" | choose -p 'Void packages (type to filter)')
    selected=$(printf '%s\n' "$choice" | sed 's/ —.*//')
    [ -n "$selected" ] || return
    [ "$(printf 'Install %s\nCancel\n' "$selected" | choose -p 'Confirm')" = "Install $selected" ] || return 1
    install_packages "$selected"
}

# Vendor installers. They run in the install terminal (--run-vendor-install),
# so the download progress and any error are on screen.
install_vscode() {
    case "$(uname -m)" in
        x86_64) arch=x64; folder=VSCode-linux-x64 ;;
        aarch64) arch=arm64; folder=VSCode-linux-arm64 ;;
        *) note 'VS Code unavailable' "Unsupported architecture: $(uname -m)"; return 1 ;;
    esac
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/abyss-vscode.XXXXXX") || return 1
    echo 'Downloading the latest stable VS Code from Microsoft...'
    if ! curl -fL --proto '=https' --tlsv1.2 "https://update.code.visualstudio.com/latest/linux-$arch/stable" -o "$tmp/code.tar.gz"; then
        rm -rf "$tmp"; note 'Download failed' 'Could not download VS Code from Microsoft.'; return 1
    fi
    mkdir -p "$HOME/.local/opt" "$HOME/.local/bin" "$HOME/.local/share/applications"
    echo 'Unpacking...'
    tar -xzf "$tmp/code.tar.gz" -C "$tmp" || { rm -rf "$tmp"; return 1; }
    rm -rf "$HOME/.local/opt/vscode"
    mv "$tmp/$folder" "$HOME/.local/opt/vscode" || { rm -rf "$tmp"; return 1; }
    ln -sf "$HOME/.local/opt/vscode/code" "$HOME/.local/bin/code"
    cat > "$HOME/.local/share/applications/abyss-vscode.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Visual Studio Code
Exec=$HOME/.local/opt/vscode/code %F
Icon=$HOME/.local/opt/vscode/resources/app/resources/linux/code.png
Terminal=false
Categories=Development;IDE;
EOF
    rm -rf "$tmp"
    note 'VS Code installed' 'Microsoft latest stable archive installed in ~/.local/opt/vscode.'
}

install_artcraft() {
    case "$(uname -m)" in x86_64) arch=x86_64 ;; aarch64) arch=aarch64 ;; *) note 'ArtCraft unavailable' "Unsupported architecture: $(uname -m)"; return 1 ;; esac
    api=https://api.github.com/repos/storytold/craft-launcher/releases/latest
    release=$(curl -fsSL --proto '=https' --tlsv1.2 "$api") || { note 'ArtCraft download unavailable' 'Could not read the latest official release.'; return 1; }
    tag=$(printf '%s\n' "$release" | awk -F '"' '/"tag_name":/ { print $4; exit }')
    url=$(printf '%s\n' "$release" | awk -v suffix="linux-$arch.AppImage" '/"browser_download_url":/ { u=$0; sub(/^.*"browser_download_url":[[:space:]]*"/, "", u); sub(/"[,]?$/, "", u); if (u ~ suffix "$" && u ~ /^https:\/\/github\.com\/storytold\/craft-launcher\/releases\/download\//) { print u; exit } }')
    case "$tag" in *[!A-Za-z0-9._-]*|'') tag= ;; esac
    [ -n "$tag" ] || { note 'ArtCraft download unavailable' 'Could not determine the latest official release tag.'; return 1; }
    [ -n "$url" ] || { note 'ArtCraft download unavailable' 'Could not find the latest official AppImage release.'; return 1; }
    file=${url##*/}
    # Pin the checksum file to the same release as the API asset; the moving
    # /latest/download endpoint can change between the two requests.
    sums="https://github.com/storytold/craft-launcher/releases/download/$tag/SHA256SUMS.txt"
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/abyss-artcraft.XXXXXX") || return 1
    if ! curl -fL --proto '=https' --tlsv1.2 "$url" -o "$tmp/$file" || ! curl -fL --proto '=https' --tlsv1.2 "$sums" -o "$tmp/SHA256SUMS.txt"; then
        rm -rf "$tmp"; note 'Download failed' 'Could not download ArtCraft and its checksum.'; return 1
    fi
    expected=$(awk -v f="$file" '{ name=$2; sub(/^\*/, "", name); if (name == f) { print $1; exit } }' "$tmp/SHA256SUMS.txt")
    actual=$(sha256sum "$tmp/$file" | awk '{print $1}')
    if ! printf '%s\n' "$expected" | grep -Eq '^[[:xdigit:]]{64}$' || [ "$actual" != "$expected" ]; then
        rm -rf "$tmp"; note 'Checksum failed' 'The ArtCraft download did not match its published checksum.'; return 1;
    fi
    mkdir -p "$HOME/.local/opt" "$HOME/.local/bin" "$HOME/.local/share/applications"
    install -m 0755 "$tmp/$file" "$HOME/.local/opt/artcraft-launcher.AppImage"
    ln -sf "$HOME/.local/opt/artcraft-launcher.AppImage" "$HOME/.local/bin/artcraft-launcher"
    cat > "$HOME/.local/share/applications/artcraft-launcher.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=ArtCraft Launcher
Exec=$HOME/.local/opt/artcraft-launcher.AppImage
Terminal=false
Categories=Graphics;
EOF
    rm -rf "$tmp"
    note 'ArtCraft Launcher installed' 'Latest official release installed in ~/.local/opt.'
}

install_cursor() {
    case "$(uname -m)" in x86_64) arch=x64 ;; aarch64) arch=arm64 ;; *) note 'Cursor unavailable' "Unsupported architecture: $(uname -m)"; return 1 ;; esac
    page=https://cursor.com/download
    url=$(curl -fsSL --proto '=https' --tlsv1.2 "$page" | sed 's#\\/#/#g' | grep -oE "https://api2\\.cursor\\.sh/updates/download/golden/linux-$arch/cursor/[0-9.]+" | head -n 1)
    case "$url" in https://api2.cursor.sh/updates/download/golden/linux-"$arch"/cursor/[0-9.]*) ;; *) note 'Cursor download unavailable' 'Could not resolve the latest official AppImage download.'; return 1 ;; esac
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/abyss-cursor.XXXXXX") || return 1
    if ! curl -fL --proto '=https' --tlsv1.2 "$url" -o "$tmp/cursor.AppImage"; then
        rm -rf "$tmp"; note 'Download failed' 'Could not download Cursor from its official release service.'; return 1
    fi
    mkdir -p "$HOME/.local/opt" "$HOME/.local/bin" "$HOME/.local/share/applications"
    install -m 0755 "$tmp/cursor.AppImage" "$HOME/.local/opt/cursor.AppImage"
    ln -sf "$HOME/.local/opt/cursor.AppImage" "$HOME/.local/bin/cursor"
    cat > "$HOME/.local/share/applications/cursor.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Cursor
Exec=$HOME/.local/opt/cursor.AppImage --appimage-extract-and-run %F
Terminal=false
Categories=Development;IDE;
EOF
    rm -rf "$tmp"
    note 'Cursor installed' 'Latest official Linux AppImage installed in ~/.local/opt.'
}

install_ollama() {
    curl -fsSL --proto '=https' --tlsv1.2 https://ollama.com/install.sh | abyss-priv sh
}

install_claude_code() {
    curl -fsSL --proto '=https' --tlsv1.2 https://claude.ai/install.sh | bash
}

install_opencode() {
    curl -fsSL --proto '=https' --tlsv1.2 https://opencode.ai/v2/install | bash
}

open_official_page() {
    url=$1
    for browser in firefox google-chrome chromium; do
        if has "$browser"; then setsid -f "$browser" "$url" >/dev/null 2>&1; return; fi
    done
    term 'Official download' "printf '%s\\n\\n' 'Open this official page after installing a browser:' '$url'; printf 'Press Enter to close '; read _"
}

# label<TAB>action[<TAB>architectures]. Package names must exist in the Void
# repositories (tests/test_software_packages.py checks them for x86_64 and
# aarch64); a package or entry that exists on one architecture only carries
# its architectures (pkg:foo@x86_64, or a third column x86_64) and is hidden
# elsewhere. Thunar is spelled with a capital T in Void; PipeWire's pulse
# server is part of the pipewire package.
catalog() {
    if [ -n "${ABYSS_SOFTWARE_CATALOG:-}" ]; then cat "$ABYSS_SOFTWARE_CATALOG"; return; fi
    cat <<'EOF'
Firefox (Void package)	pkg:firefox
Google Chrome (official download)	chrome
Chromium (Void package)	pkg:chromium
Virtual machines (QEMU + virt-manager)	pkg:qemu libvirt virt-manager bridge-utils
Docker Engine	pkg:docker docker-compose docker-buildx
VLC media player	pkg:vlc
External storage (udisks + GVFS)	pkg:udisks2 gvfs Thunar
Visual Studio Code (latest stable)	vscode
Git (version control)	pkg:git
ArtCraft Launcher	artcraft
Ollama (official installer)	ollama
Claude Code CLI	claude-code
OpenCode CLI	opencode
Google Antigravity (download page)	antigravity
Cursor (latest AppImage)	cursor
ChatGPT (web app)	chatgpt
Audio support (PipeWire + mixer)	pkg:pipewire wireplumber pavucontrol
Terminal workspace (Vim, lf, fzf, ripgrep, tmux)	pkg:vim lf fzf ripgrep tmux
Passwords (pass + browser autofill)	pkg:pass pass-otp browserpass pinentry-gtk xclip
Writing and research (TeX Live, Zathura; about 1.8 GB download)	pkg:vim texlive zathura zathura-pdf-mupdf
Media tools (mpv, yt-dlp, ffmpeg)	pkg:mpv yt-dlp ffmpeg xclip
Bluetooth support	pkg:bluez
Laptop brightness controls	pkg:brightnessctl
Screenshot capture (optional)	pkg:maim
Search Void packages	search
EOF
}

# The menu for ARCH: entries not offered there are left out, bundles lose the
# packages that do not exist there, and single-architecture entries say so.
entries() {  # entries ARCH
    catalog | while IFS='	' read -r label action arches; do
        offered_on "$1" "$arches" || continue
        case $action in
            pkg:*) pkgs=$(arch_packages "$1" "${action#pkg:}"); [ -n "$pkgs" ] || continue; action="pkg:$pkgs" ;;
        esac
        case ${arches:-all} in all) ;; *) label="$label (only on $(printf '%s' "$arches" | sed 's/,/, /g'))" ;; esac
        printf '%s\t%s\n' "$label" "$action"
    done
}

# Names of the installed packages, one per line (one local xbps-query call).
installed_packages() {
    xbps-query -l 2>/dev/null | awk '{ n = $2; sub(/-[^-]*$/, "", n); print n }'
}

# Names of the packages in the enabled repositories, one per line, from the
# package lists already on this computer (one xbps-query call, no network,
# about 0.1 s). Fails when the lists cannot tell: a repository has none yet
# (never synced) or the listing is empty.
repo_packages() {
    lists=$(xbps-query -L 2>/dev/null) && [ -n "$lists" ] || return 1
    ! printf '%s\n' "$lists" | grep -q '^[[:space:]]*-1[[:space:]]' || return 1
    # lines are "[-] name-version_revision  description"
    names=$(xbps-query -Rs '' 2>/dev/null | awk '{ n = $2; sub(/-[^-]*$/, "", n); if (n != "") print n }')
    [ -n "$names" ] && printf '%s\n' "$names"
}

# The packages among NAMES that the enabled repositories do not have right
# now (Void removes a package while it rebuilds it, for instance). A name
# missing from REPO_PKGS (repo_packages, read once per menu) is confirmed
# with the query the installer itself uses: a virtual package is only found
# that way. Prints nothing when the lists cannot tell.
unavailable_packages() {  # unavailable_packages "name..."
    [ -n "${REPO_PKGS+x}" ] || REPO_PKGS=$(repo_packages) || REPO_PKGS=
    [ -n "$REPO_PKGS" ] || return 0
    out=
    for pkg in $1; do
        printf '%s\n' "$REPO_PKGS" | grep -qxF "$pkg" && continue
        xbps-query -R "$pkg" >/dev/null 2>&1 && continue
        out="$out $pkg"
    done
    printf '%s\n' "${out# }"
}

# ---------------------------------------------------------------- installed?
# The app's name without the notes in brackets: "Visual Studio Code".
app_name() { printf '%s\n' "$1" | sed 's/ *([^)]*)//g; s/[[:space:]]*$//'; }

# A stable name for an entry: the vendor action, or the package bundle's
# name in lower case ("virtual-machines"). Shortcuts are saved under it.
entry_key() {  # entry_key LABEL ACTION
    case $2 in
        pkg:*) app_name "$1" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//' | cut -c1-40 ;;
        *) printf '%s\n' "$2" ;;
    esac
}

# Where each vendor app is once installed, most likely first: the places
# its installer above uses, then the usual system, npm and Flatpak ones.
# ABYSS_ROOT prefixes system paths (tests).
vendor_locations() {  # vendor_locations ACTION
    r=${ABYSS_ROOT:-}
    case $1 in
        vscode) printf '%s\n' "$HOME/.local/opt/vscode/code" "$r/usr/bin/code" "$r/usr/local/bin/code" \
                    "$r/opt/visual-studio-code/code" "$r/usr/share/code/code" "$r/usr/bin/code-oss" \
                    flatpak:com.visualstudio.code ;;
        cursor) printf '%s\n' "$HOME/.local/opt/cursor.AppImage" "$r/usr/bin/cursor" "$r/opt/cursor/cursor" \
                    "$r/opt/Cursor/cursor" ;;
        artcraft) printf '%s\n' "$HOME/.local/opt/artcraft-launcher.AppImage" ;;
        ollama) printf '%s\n' "$r/usr/local/bin/ollama" "$r/usr/bin/ollama" ;;
        claude-code) printf '%s\n' "$HOME/.local/bin/claude" "$HOME/.claude/local/claude" "$r/usr/local/bin/claude" \
                    "$r/usr/bin/claude" cmd:claude ;;
        opencode) printf '%s\n' "$HOME/.opencode/bin/opencode" "$HOME/.local/bin/opencode" \
                    "$r/usr/local/bin/opencode" "$r/usr/bin/opencode" cmd:opencode ;;
        chrome) printf '%s\n' "$r/usr/bin/google-chrome-stable" "$r/usr/bin/google-chrome" \
                    "$r/opt/google/chrome/google-chrome" flatpak:com.google.Chrome ;;
        antigravity) printf '%s\n' "$HOME/.local/opt/antigravity/antigravity" "$r/usr/bin/antigravity" \
                    "$r/usr/local/bin/antigravity" "$r/opt/Antigravity/antigravity" "$r/opt/antigravity/antigravity" ;;
    esac
}

# The installed vendor app: a path, or flatpak:<id>; nothing when absent.
vendor_path() {  # vendor_path ACTION
    vendor_locations "$1" | while IFS= read -r loc; do
        case $loc in
            flatpak:*) has flatpak && flatpak info "${loc#flatpak:}" >/dev/null 2>&1 || continue ;;
            cmd:*) loc=$(command -v "${loc#cmd:}" 2>/dev/null) || continue
                   case $loc in /*) ;; *) continue ;; esac ;;
            *) [ -f "$loc" ] && [ -x "$loc" ] || continue ;;
        esac
        printf '%s\n' "$loc"; break
    done
}

# Installed state of a catalogue entry: all, part:<missing packages> or
# none; nothing for entries without one (links, search). Packages are looked
# up in INSTALLED_PKGS (installed_packages, read once per menu).
is_installed() {  # is_installed ACTION; status 0 when fully installed
    case $1 in
        pkg:*)
            [ -n "${INSTALLED_PKGS+x}" ] || INSTALLED_PKGS=$(installed_packages)
            missing=
            for pkg in ${1#pkg:}; do
                printf '%s\n' "$INSTALLED_PKGS" | grep -qxF "$pkg" || missing="$missing $pkg"
            done
            if [ -z "$missing" ]; then echo all; return 0
            elif [ "$missing" = " ${1#pkg:}" ]; then echo none
            else echo "part:${missing# }"; fi
            return 1 ;;
        search|chatgpt|'') return 1 ;;
        *) if [ -n "$(vendor_path "$1")" ]; then echo all; return 0; fi
           echo none; return 1 ;;
    esac
}

# The command line of desktop file FILE (its Exec, without %U and the other
# field codes) when FILE is an app the menus show: Type=Application with an
# Exec line, not NoDisplay or Hidden. Those are services and helpers: Void's
# pipewire.desktop runs the PipeWire daemon (NoDisplay), so the Audio bundle
# opens pavucontrol. Status 1 for anything else.
desktop_exec() {  # desktop_exec FILE
    [ -f "$1" ] || return 1
    awk '/^\[/ { main = ($0 == "[Desktop Entry]"); next }
        !main { next }
        { k = $0; sub(/[ \t]*=.*/, "", k); v = $0; sub(/^[^=]*=[ \t]*/, "", v) }
        k == "Type" { type = v } k == "Exec" { exec = v }
        k == "NoDisplay" && v == "true" { hidden = 1 }
        k == "Hidden" && v == "true" { hidden = 1 }
        END {
            gsub(/%[fFuUdDnNickvm]/, "", exec); gsub(/%%/, "%", exec)
            gsub(/^[ \t]+|[ \t]+$/, "", exec)
            if (type != "Application" || hidden || exec == "") exit 1
            print exec
        }' "$1"
}

# The desktop file of the app that command CMD is: CMD.desktop, else one
# whose Exec line runs CMD (org.pulseaudio.pavucontrol.desktop); only
# files desktop_exec accepts.
desktop_file() {  # desktop_file CMD
    dir=${ABYSS_APPLICATIONS_DIR:-/usr/share/applications}
    for f in "$dir/$1.desktop" $(grep -lE "^Exec=(/usr/bin/)?$1( |\$)" "$dir"/*.desktop 2>/dev/null); do
        desktop_exec "$f" >/dev/null 2>&1 && { printf '%s\n' "$f"; return 0; }
    done
    return 1
}

# The first package of a bundle that is a desktop application, as a command.
app_command() {
    for pkg in $1; do
        cmd=$(printf '%s' "$pkg" | tr 'A-Z' 'a-z')
        if has "$cmd" && desktop_file "$cmd" >/dev/null; then
            printf '%s\n' "$cmd"; return 0
        fi
    done
    return 1
}

quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# How an installed entry is opened: "exec<TAB>command" for a window,
# "term<TAB>command" for a terminal program; nothing (status 1) when the
# entry has nothing to open (a driver bundle, git, a missing app).
open_command() {  # open_command ACTION
    case $1 in
        pkg:*)
            # the app's own command line: a bare "mpv" only prints its usage
            cmd=$(app_command "${1#pkg:}") && app_file=$(desktop_file "$cmd") &&
                app_run=$(desktop_exec "$app_file") || return 1
            if grep -q '^Terminal=true' "$app_file" 2>/dev/null; then
                printf 'term\t%s\n' "$app_run"
            else printf 'exec\t%s\n' "$app_run"; fi ;;
        search|chatgpt) return 1 ;;
        *)
            path=$(vendor_path "$1"); [ -n "$path" ] || return 1
            case $path in
                flatpak:*) printf 'exec\tflatpak run %s\n' "${path#flatpak:}"; return 0 ;;
            esac
            case $1 in
                cursor) case $path in
                            *.AppImage) printf 'exec\t%s --appimage-extract-and-run\n' "$(quote "$path")" ;;
                            *) printf 'exec\t%s\n' "$(quote "$path")" ;;
                        esac ;;
                ollama) printf 'term\t%s\n' "echo 'Ollama: start the server with \"ollama serve\", then run a model with \"ollama run llama3.2\".'; $(quote "$path") list 2>/dev/null; exec \"\${SHELL:-/bin/sh}\"" ;;
                claude-code|opencode) printf 'term\t%s\n' "$(quote "$path")" ;;
                *) printf 'exec\t%s\n' "$(quote "$path")" ;;
            esac ;;
    esac
}

launch() {  # launch "exec|term<TAB>command" NAME
    kind=${1%%	*} cmd=${1#*	}
    if [ "$kind" = term ]; then setsid -f st -t "$2" -e sh -c "$cmd" >/dev/null 2>&1
    else setsid -f sh -c "$cmd" >/dev/null 2>&1; fi
}

# The entry saved under KEY: "label<TAB>action" (abyss-software --open KEY).
find_entry() {  # find_entry KEY
    entries "$(machine_arch)" | while IFS='	' read -r label action; do
        [ "$(entry_key "$label" "$action")" = "$1" ] && { printf '%s\t%s\n' "$label" "$action"; break; }
    done
}

open_entry() {  # open_entry KEY (the target of the app's keyboard shortcut)
    line=$(find_entry "$1")
    label=${line%%	*} action=${line#*	}
    name=$(app_name "$label")
    if [ -z "$line" ] || ! how=$(open_command "$action"); then
        note "${name:-$1} is not installed" 'Open Software → Install software to install it again.'
        return 1
    fi
    launch "$how" "$name"
}

# ---------------------------------------------------------------- shortcuts
# Every app the menu can open gets a keyboard shortcut the first time it is
# seen installed: Super+Alt+<letter>, the app's initial when free. dwm
# binds no Super+Alt letter (only Super+Alt+Return, 0, = and -), unlike
# Super+Shift (C closes a window, Q logs out, B, J, K, L ...); Super+Alt+
# Shift+<letter> is the fallback. Shortcuts are records in dwm's per-user
# file (A<TAB>id<TAB>mod<TAB>key<TAB>name<TAB>action), applied live with
# abyss-key-capture --reload and checked against what dwm then publishes.
SHORTCUT_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/abyss
SHORTCUT_CONF=$SHORTCUT_DIR/shortcuts.conf
# Keys of apps that were given a shortcut: one the user cleared stays clear.
SHORTCUT_STATE=$SHORTCUT_DIR/software-shortcuts
SHORTCUT_MODS='72 73'   # Super+Alt, Super+Alt+Shift (X modifier masks)

live_bindings() { abyss-key-capture --list 2>/dev/null; }

chord() {  # chord MOD KEY -> Super+Alt+V
    awk -v m="$1" -v k="$2" 'BEGIN {
        r = ""; if (int(m/64)%2) r = r "Super+"; if (int(m/8)%2) r = r "Alt+"
        if (int(m/4)%2) r = r "Ctrl+"; if (int(m)%2) r = r "Shift+"
        if (length(k) == 1) k = toupper(k); print r k }'
}

# Letters to try for NAME: word initials, then its other letters, then a-z.
shortcut_letters() {
    printf '%s\n' "$1" | awk '
        function add(c) { if (c ~ /^[a-z]$/ && !(c in seen)) { seen[c] = 1; printf "%s ", c } }
        { s = tolower($0); n = split(s, w, /[^a-z]+/)
          for (i = 1; i <= n; i++) add(substr(w[i], 1, 1))
          for (i = 1; i <= length(s); i++) add(substr(s, i, 1))
          for (i = 1; i <= 26; i++) add(substr("abcdefghijklmnopqrstuvwxyz", i, 1)) }'
}

# The shortcut of KEY in BINDINGS (abyss-key-capture --list), as text.
shortcut_of() {  # shortcut_of KEY BINDINGS
    rec=$(printf '%s\n' "$2" | awk -F '\t' -v id="software-$1" '$1 == "A" && $2 == id { print $3 "\t" $4; exit }')
    [ -n "$rec" ] && chord "${rec%%	*}" "${rec#*	}"
}

# Give every app in WANTED (lines key<TAB>name) without a shortcut a free
# one, and drop the shortcuts this script made for apps no longer installed.
# Prints "+<TAB>chord<TAB>name" / "-<TAB>chord<TAB>name" per change. Does
# nothing without a running Abyss dwm (no X, a console, a test).
sync_shortcuts() {  # sync_shortcuts WANTED_FILE
    bindings=$(live_bindings) && [ -n "$bindings" ] || return 0
    mkdir -p "$SHORTCUT_DIR" || return 1
    t=$(mktemp -d "${TMPDIR:-/tmp}/abyss-keys.XXXXXX") || return 1
    printf '%s\n' "$bindings" > "$t/live"
    [ -f "$SHORTCUT_STATE" ] && cp "$SHORTCUT_STATE" "$t/state" || : > "$t/state"
    # ours (software-*), for apps that are gone
    awk -F '\t' 'FILENAME == ARGV[1] { want["software-" $1] = 1; next }
        $1 == "A" && $2 ~ /^software-/ && !($2 in want)' "$1" "$t/live" > "$t/stale"
    # every combination in use: dwm's own (B) and application shortcuts (A)
    awk -F '\t' '$1 == "B" && $5 != "-" { print $4 "\t" tolower($5) }
        $1 == "A" { print $3 "\t" tolower($4) }' "$t/live" > "$t/taken"
    : > "$t/add"
    while IFS='	' read -r key name; do
        [ -n "$key" ] || continue
        awk -F '\t' -v id="software-$key" '$1 == "A" && $2 == id { f = 1 } END { exit !f }' "$t/live" && continue
        grep -qxF "$key" "$t/state" && continue      # the user cleared it
        pick=
        for mod in $SHORTCUT_MODS; do
            for letter in $(shortcut_letters "$name"); do
                grep -qxF "$mod	$letter" "$t/taken" && continue
                # another program (not dwm) may hold it
                abyss-key-capture --probe "$mod" "$letter" >/dev/null 2>&1 || continue
                pick="$mod	$letter"; break 2
            done
        done
        [ -n "$pick" ] || continue
        printf 'A\tsoftware-%s\t%s\t%s\texec:abyss-software --open %s\n' "$key" "$pick" "$name" "$key" >> "$t/add"
        printf '%s\n' "$pick" >> "$t/taken"
    done < "$1"
    if [ -s "$t/stale" ] || [ -s "$t/add" ]; then
        [ -f "$SHORTCUT_CONF" ] && cp "$SHORTCUT_CONF" "$t/old" || : > "$t/old"
        { awk -F '\t' 'FILENAME == ARGV[1] { drop[$2] = 1; next } !($1 == "A" && ($2 in drop))' \
              "$t/stale" "$t/old"; cat "$t/add"; } > "$t/new"
        chmod 600 "$t/new" && cp "$t/new" "$SHORTCUT_CONF" || { rm -rf "$t"; return 1; }
        abyss-key-capture --reload >/dev/null 2>&1
        # dwm applies the file at once; it ignores the whole file when it is
        # invalid, so check what it publishes and put the old file back if so
        tries=${ABYSS_RELOAD_TRIES:-10} ok=
        while [ "$tries" -gt 0 ]; do
            sleep "${ABYSS_RELOAD_POLL:-0.3}"
            live_bindings > "$t/now"
            if awk -F '\t' 'FILENAME == ARGV[1] { add[$2] = $3 "\t" $4; next }
                    FILENAME == ARGV[2] { gone[$2] = 1; next }
                    $1 == "A" && ($2 in gone) { bad = 1 }
                    $1 == "A" && ($2 in add) && add[$2] == $3 "\t" $4 { seen[$2] = 1 }
                    END { for (k in add) if (!(k in seen)) bad = 1; exit bad }' \
                    "$t/add" "$t/stale" "$t/now"; then ok=1; break; fi
            tries=$((tries - 1))
        done
        if [ -z "$ok" ]; then
            cp "$t/old" "$SHORTCUT_CONF"; abyss-key-capture --reload >/dev/null 2>&1
            rm -rf "$t"; return 1
        fi
        awk -F '\t' '{ sub(/^software-/, "", $2); print $2 }' "$t/add" >> "$t/state"
        awk -F '\t' '{ print "+\t" $3 "\t" $4 "\t" $5 }' "$t/add" > "$t/report"
        awk -F '\t' '{ print "-\t" $3 "\t" $4 "\t" $5 }' "$t/stale" >> "$t/report"
        while IFS='	' read -r sign mod key name; do
            printf '%s\t%s\t%s\n' "$sign" "$(chord "$mod" "$key")" "$name"
        done < "$t/report"
    fi
    # forget apps that are gone, so installing one again gives it a shortcut
    awk -F '\t' 'FILENAME == ARGV[1] { want[$1] = 1; next } ($1 in want)' "$1" "$t/state" | sort -u > "$t/state.new"
    if ! cmp -s "$t/state.new" "$SHORTCUT_STATE" 2>/dev/null; then
        cp "$t/state.new" "$SHORTCUT_STATE" 2>/dev/null
    fi
    rm -rf "$t"
}

# ---------------------------------------------------------------- the menu
# One row per entry: display label, action, state (is_installed), key, name,
# and the packages still to install that the repositories do not have right
# now ("-" for none). Installed entries are marked, with their keyboard
# shortcut; unavailable packages are named.
menu_entries() {  # menu_entries ARCH
    [ -n "${INSTALLED_PKGS+x}" ] || INSTALLED_PKGS=$(installed_packages)
    [ -n "${REPO_PKGS+x}" ] || REPO_PKGS=$(repo_packages) || REPO_PKGS=
    rows=$(entries "$1" | while IFS='	' read -r label action; do
        state=$(is_installed "$action")
        key=$(entry_key "$label" "$action")
        opens=0; [ "$state" = all ] || [ "${state#part:}" != "$state" ] &&
            open_command "$action" >/dev/null && opens=1
        unavail=   # (no case here: a bare ")" pattern ends this $( ) in some shells)
        if [ "${action#pkg:}" != "$action" ]; then
            if [ "$state" = none ]; then unavail=$(unavailable_packages "${action#pkg:}")
            elif [ "${state#part:}" != "$state" ]; then unavail=$(unavailable_packages "${state#part:}"); fi
        fi
        # no empty fields: read splits on runs of tabs
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$label" "$action" "${state:--}" "$key" "$(app_name "$label")" \
            "$opens" "${unavail:--}"
    done)
    wanted=$(mktemp "${TMPDIR:-/tmp}/abyss-wanted.XXXXXX") || return 1
    printf '%s\n' "$rows" | awk -F '\t' '$6 == 1 { print $4 "\t" $5 }' > "$wanted"
    if [ -z "${ABYSS_NO_SHORTCUTS:-}" ]; then
        SHORTCUT_CHANGES=$(sync_shortcuts "$wanted")
    fi
    rm -f "$wanted"
    bindings=$(live_bindings) || bindings=
    printf '%s\n' "$rows" | while IFS='	' read -r label action state key name opens unavail; do
        keys=; [ "$opens" = 1 ] && [ -n "$bindings" ] && keys=$(shortcut_of "$key" "$bindings")
        case $state in
            all) label="$label  ✓ installed${keys:+ · $keys}" ;;
            part:*) label="$label  (partly installed, missing: ${state#part:})${keys:+ · $keys}" ;;
        esac
        if [ "$unavail" != - ]; then
            case $state in part:*) need=${state#part:} ;; *) need=${action#pkg:} ;; esac
            if [ "$unavail" = "$need" ]; then label="$label  (not available on $1 right now)"
            else label="$label  ($unavail not available on $1 right now)"; fi
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$label" "$action" "$state" "$key" "$name" "$unavail"
    done
}

# Every package an entry still needs is missing from the repositories: say
# so instead of opening an install that can only fail. Trying anyway runs the
# installer, which updates stale package lists first and names what is
# missing. Returns 0 to try.
offer_unavailable() {  # offer_unavailable NAME ARCH
    answer=$(printf 'Back\nTry anyway\n' |
        choose -p "$1 is not available for $2 in the enabled repositories right now (Void may be rebuilding it; try again later)") || return 1
    [ "$answer" = 'Try anyway' ]
}

# After an install or removal (in its terminal): shortcuts for new apps,
# none for removed ones, and say which.
shortcuts_after_change() {
    [ "$(id -u)" -ne 0 ] || return 0
    unset INSTALLED_PKGS
    REPO_PKGS=   # availability is not shown here: skip that query
    menu_entries "$(machine_arch)" >/dev/null
    printf '%s\n' "$SHORTCUT_CHANGES" | while IFS='	' read -r sign keys name; do
        case $sign in
            +) echo "Keyboard shortcut: $keys opens $name" ;;
            -) echo "Keyboard shortcut $keys ($name) removed" ;;
        esac
    done
}

remove_packages() {  # remove_packages "name..."
    valid_names "$1" || return 1
    answer=$(printf 'Remove %s\nCancel\n' "$1" | choose -p 'Remove (unused dependencies go too)')
    [ "$answer" = "Remove $1" ] || return 1
    term 'Remove software' "/bin/sh '$SELF' --run-remove $1"
}

run_remove() {
    wait_for_xbps
    abyss-priv xbps-remove -R "$@"; status=$?
    echo
    echo '==================== Summary ===================='
    if [ "$status" -eq 0 ]; then echo "Removed: $*"
    else echo "Removing $* did not finish (xbps-remove exit $status); see the messages above."; fi
    return "$status"
}

# Vendor apps this script can remove: those installed in the home folder
# by the installers above (system-wide ones belong to their own tools).
vendor_files() {  # vendor_files ACTION PATH -> files and folders to delete
    case $1:$2 in
        vscode:"$HOME/.local/opt/vscode/code")
            printf '%s\n' "$HOME/.local/opt/vscode" "$HOME/.local/share/applications/abyss-vscode.desktop"
            [ "$(readlink "$HOME/.local/bin/code" 2>/dev/null)" = "$HOME/.local/opt/vscode/code" ] && echo "$HOME/.local/bin/code" ;;
        cursor:"$HOME/.local/opt/cursor.AppImage")
            printf '%s\n' "$2" "$HOME/.local/share/applications/cursor.desktop"
            [ -L "$HOME/.local/bin/cursor" ] && echo "$HOME/.local/bin/cursor" ;;
        artcraft:"$HOME/.local/opt/artcraft-launcher.AppImage")
            printf '%s\n' "$2" "$HOME/.local/share/applications/artcraft-launcher.desktop"
            [ -L "$HOME/.local/bin/artcraft-launcher" ] && echo "$HOME/.local/bin/artcraft-launcher" ;;
        claude-code:"$HOME/.local/bin/claude")       # the native installer's layout
            printf '%s\n' "$2" "$HOME/.local/share/claude" ;;
        opencode:"$HOME/.opencode/bin/opencode")
            printf '%s\n' "$HOME/.opencode" ;;
        *) return 1 ;;
    esac
}

run_vendor_remove() {  # run_vendor_remove ACTION NAME
    path=$(vendor_path "$1")
    files=$(vendor_files "$1" "$path") || { echo "$2 was not installed by Install software; remove it with the tool that installed it."; return 1; }
    printf '%s\n' "$files" | while IFS= read -r f; do
        [ -n "$f" ] || continue
        echo "Removing $f"; rm -rf "$f"
    done
    echo
    echo '==================== Summary ===================='
    if [ -z "$(vendor_path "$1")" ]; then echo "Removed: $2"; else echo "$2 is still installed at $(vendor_path "$1")."; fi
    shortcuts_after_change
}

vendor_name() { line=$(catalog | awk -F '\t' -v a="$1" '$2 == a { print $1; exit }'); app_name "${line:-$1}"; }

# Runs in the install terminal: optionally Git first (it needs the password,
# then the long download can run unattended), then the vendor installer.
run_vendor_install() {  # run_vendor_install ACTION [--with-git]
    ABYSS_IN_TERMINAL=1
    action=$1 name=$(vendor_name "$1")
    if [ "${2:-}" = --with-git ]; then
        echo "Installing Git (Source Control in $name needs it)..."
        run_install git || echo 'Git was not installed; you can add it later from Install software.'
        echo
    fi
    case $action in
        vscode) install_vscode ;; artcraft) install_artcraft ;; cursor) install_cursor ;;
        ollama) install_ollama ;; claude-code) install_claude_code ;; opencode) install_opencode ;;
        *) echo "Unknown app: $action"; return 2 ;;
    esac
    rc=$?
    echo
    echo '==================== Summary ===================='
    if path=$(vendor_path "$action") && [ -n "$path" ]; then echo "Installed: $name ($path)"; rc=0
    else echo "Not installed: $name (see the messages above)"; [ "$rc" -ne 0 ] || rc=1; fi
    shortcuts_after_change
    return "$rc"
}

# Before installing an editor, offer Git with it: Source Control needs it.
offer_vendor_install() {  # offer_vendor_install ACTION NAME
    git=
    case $1 in
        vscode|cursor)
            if ! is_installed pkg:git >/dev/null; then
                answer=$(printf 'Install %s + Git (Source Control needs Git)\nInstall %s only\nCancel\n' "$2" "$2" |
                    choose -p "$2") || return 1
                case $answer in *'+ Git'*) git=--with-git ;; 'Install '*) ;; *) return 1 ;; esac
            fi ;;
        ollama)
            [ "$(printf 'Install latest Ollama\nCancel\n' | choose -p 'This runs Ollama’s official system installer')" = 'Install latest Ollama' ] || return 1 ;;
        claude-code)
            [ "$(printf 'Install latest Claude Code CLI\nCancel\n' | choose -p 'This installs to your home directory')" = 'Install latest Claude Code CLI' ] || return 1 ;;
        opencode)
            [ "$(printf 'Install latest OpenCode CLI\nCancel\n' | choose -p 'This installs to your home directory')" = 'Install latest OpenCode CLI' ] || return 1 ;;
    esac
    term "Install $2" "/bin/sh '$SELF' --run-vendor-install $1 $git"
}

official_page() {
    case $1 in
        chrome) echo 'https://www.google.com/chrome/' ;;
        antigravity) echo 'https://antigravity.google/download?os=linux' ;;
        chatgpt) echo 'https://chatgpt.com' ;;
    esac
}

change_shortcut() {  # change_shortcut KEY NAME
    mkdir -p "$SHORTCUT_DIR" && { grep -qxF "$1" "$SHORTCUT_STATE" 2>/dev/null || echo "$1" >> "$SHORTCUT_STATE"; }
    setsid -f abyss-shortcut-editor --app "software-$1" "$2" "exec:abyss-software --open $1" >/dev/null 2>&1
}

# An installed (or partly installed) entry: open, update, remove, change its
# shortcut. Returns 0 when a terminal or app was opened (the menu closes).
entry_actions() {  # entry_actions ACTION STATE KEY NAME
    action=$1 state=$2 key=$3 name=$4 options=
    how=$(open_command "$action") || how=
    case $action in pkg:*) pkgs=${action#pkg:}; opener="Open $(app_command "$pkgs")" ;; *) opener="Open $name" ;; esac
    [ -n "$how" ] && options="$opener
"
    prompt="$name: installed"
    case $state in
        part:*)
            missing=${state#part:} present=
            for pkg in $pkgs; do case " $missing " in *" $pkg "*) ;; *) present="$present $pkg" ;; esac; done
            options="${options}Install missing: $missing
Remove installed parts:$present
"
            prompt="$name: partly installed" ;;
        *)
            options="${options}Update
"
            case $action in
                vscode|cursor) is_installed pkg:git >/dev/null || options="${options}Install Git (Source Control needs it)
" ;;
            esac
            case $action in
                pkg:*) options="${options}Remove
" ;;
                *) vendor_files "$action" "$(vendor_path "$action")" >/dev/null && options="${options}Remove
" ;;
            esac ;;
    esac
    [ -n "$how" ] && live_bindings >/dev/null && options="${options}Change shortcut…
"
    choice=$(printf '%sBack\n' "$options" | choose -p "$prompt") || return 1
    case $choice in
        "$opener") launch "$how" "$name" ;;
        Update) case $action in
                    pkg:*) term 'Update software' "/bin/sh '$SELF' --run-install --update $pkgs" ;;
                    chrome|antigravity) open_official_page "$(official_page "$action")" ;;
                    *) term "Update $name" "/bin/sh '$SELF' --run-vendor-install $action" ;;
                esac ;;
        'Install Git'*) install_packages git ;;
        Remove) case $action in
                    pkg:*) remove_packages "$pkgs" ;;
                    *) [ "$(printf 'Remove %s\nCancel\n' "$name" | choose -p "Remove $name?")" = "Remove $name" ] || return 1
                       term "Remove $name" "/bin/sh '$SELF' --run-vendor-remove $action" ;;
                esac ;;
        'Change shortcut…') change_shortcut "$key" "$name" ;;
        'Install missing: '*) install_packages "$missing" ;;
        'Remove installed parts:'*) remove_packages "${present# }" ;;
        *) return 1 ;;
    esac
}

case "${1:-}" in
    --search) search_packages; exit 0 ;;
    --list-entries) entries "${2:-$(machine_arch)}"; exit 0 ;;
    --run-install) shift; run_install "$@"; rc=$?; shortcuts_after_change; exit $rc ;;
    --run-remove) shift; run_remove "$@"; rc=$?; shortcuts_after_change; exit $rc ;;
    --run-vendor-install) shift; run_vendor_install "$@"; exit $? ;;
    --run-vendor-remove) [ -n "${2:-}" ] || exit 2; run_vendor_remove "$2" "$(vendor_name "$2")"; exit $? ;;
    --install) [ -n "${2:-}" ] || exit 2; install_packages "$2"; exit $? ;;
    --open) [ -n "${2:-}" ] || exit 2; open_entry "$2"; exit $? ;;
    --assign-shortcuts) shortcuts_after_change; exit 0 ;;
    --installed) INSTALLED_PKGS=$(installed_packages)   # key, state, shortcut per entry
                 menu_entries "${2:-$(machine_arch)}" | awk -F '\t' '{ print $4 "\t" $3 "\t" $1 }'; exit 0 ;;
esac

while :; do
    unset INSTALLED_PKGS REPO_PKGS   # re-read: an install may have finished
    menu_arch=$(machine_arch)
    menu=$(menu_entries "$menu_arch")
    selection=$(printf '%s\n' "$menu" | cut -f1 | choose -p 'Software (type to filter)') || exit 0
    line=$(printf '%s\n' "$menu" | awk -F '\t' -v label="$selection" '$1 == label { print; exit }')
    [ -n "$line" ] || exit 0
    action=$(printf '%s\n' "$line" | cut -f2)
    state=$(printf '%s\n' "$line" | cut -f3)
    key=$(printf '%s\n' "$line" | cut -f4)
    name=$(printf '%s\n' "$line" | cut -f5)
    unavail=$(printf '%s\n' "$line" | cut -f6)
    # Close the menu once a terminal or the app is open, so it gets the focus.
    case $state in
        all|part:*) entry_actions "$action" "$state" "$key" "$name" && exit 0; continue ;;
    esac
    case "$action" in
        pkg:*) if [ "$unavail" = "${action#pkg:}" ]; then offer_unavailable "$name" "$menu_arch" || continue; fi
               install_packages "${action#pkg:}" && exit 0 ;;
        chrome|antigravity|chatgpt) open_official_page "$(official_page "$action")" ;;
        vscode|artcraft|ollama|claude-code|opencode|cursor) offer_vendor_install "$action" "$name" && exit 0 ;;
        search) search_packages && exit 0 ;;
        *) exit 0 ;;
    esac
done
