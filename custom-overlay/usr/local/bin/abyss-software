#!/bin/sh
# Minimal on-demand software browser for Void Linux.

PATH="/usr/local/bin:$HOME/.local/bin:$PATH"
NB='#0d0b18' NF='#f3e8ff' SB='#a855f7' SF='#090514'
FONT='JetBrainsMono Nerd Font:size=10'

has() { command -v "$1" >/dev/null 2>&1; }
choose() { dmenu -i -c -l 13 -fn "$FONT" -nb "$NB" -nf "$NF" -sb "$SB" -sf "$SF" "$@"; }
term() { setsid -f st -t "$1" -e sh -c "$2; echo; printf 'Press Enter to close '; read _" >/dev/null 2>&1; }
priv() { abyss-priv "$@"; }
note() {
    if has notify-send; then notify-send -a Abyss "$1" "${2:-}"
    else printf '%s — %s\n' "$1" "${2:-}" | choose -p 'Abyss'; fi
}

# This script, by absolute path, so the install terminal can run its helper.
SELF=$0
case $SELF in */*) ;; *) SELF=$(command -v "$SELF" 2>/dev/null || printf '%s' "$SELF") ;; esac
case $SELF in /*) ;; *) SELF="$PWD/$SELF" ;; esac
BIG_DOWNLOAD=$((500 * 1024 * 1024))   # ask before downloads larger than this

# The Void architecture of this machine (x86_64, aarch64, ...), without -musl.
machine_arch() {
    a=$(xbps-uhelper arch 2>/dev/null)
    [ -n "$a" ] || a=$(uname -m)
    printf '%s\n' "${a%-musl}"
}

# Is an entry for ARCHES (empty or "all", or a comma list) offered on ARCH?
offered_on() {
    case ${2:-all} in all) return 0 ;; esac
    case ",$2," in *",$1,"*) return 0 ;; esac
    return 1
}

# The packages of a bundle that exist on ARCH. A word may name the
# architectures it exists on: foo@x86_64 is installed only on x86_64.
arch_packages() {  # arch_packages ARCH "word..."
    out=
    for word in $2; do
        case $word in *@*) offered_on "$1" "${word#*@}" || continue ;; esac
        out="$out ${word%%@*}"
    done
    printf '%s\n' "${out# }"
}

valid_names() { case $1 in ''|*[!A-Za-z0-9._+\ -]*) return 1 ;; esac; }

xbps_busy() {
    pgrep -x xbps-install >/dev/null 2>&1 || pgrep -x xbps-remove >/dev/null 2>&1 ||
        pgrep -x xbps-reconfigure >/dev/null 2>&1
}

wait_for_xbps() {
    xbps_busy || return 0
    echo 'Another install or update is running; this one will start when it finishes.'
    echo '(Press Ctrl+C to cancel.)'
    while xbps_busy; do sleep "${ABYSS_LOCK_POLL:-2}"; done
    echo 'The other one has finished; continuing.'
}

explain_sync_failure() {  # explain_sync_failure LOG
    echo
    if grep -qiE 'resolv|name or service|name resolution' "$1"; then
        echo 'The package servers could not be found: this computer cannot look up'
        echo 'their names (DNS). Check that you are connected to the network, or wait'
        echo 'a minute if it has only just connected.'
    elif grep -qiE 'timed out|timeout|refused|unreachable|no route|connect' "$1"; then
        echo 'The package servers could not be reached. Check your network connection.'
    else
        echo 'The package lists could not be updated (see the messages above).'
    fi
    echo 'To retry, open Install software again, or run "update" in a terminal.'
}

# Package lists this script synced less than SYNC_FRESH_MIN minutes ago are
# used as they are, so installing several things in a row downloads them
# once. The stamp lives in /run (root only, empty after a reboot). xbps
# leaves an unchanged repodata file untouched, so its own times cannot tell.
SYNC_STAMP=${ABYSS_SYNC_STAMP:-/run/abyss-software.synced}
SYNC_FRESH_MIN=${ABYSS_SYNC_FRESH_MIN:-30}

# Are the package lists fresh? Not when a repository has none on disk
# (xbps-query -L counts -1) or the repository configuration changed since.
repos_fresh() {
    [ "$SYNC_FRESH_MIN" -gt 0 ] 2>/dev/null && [ -f "$SYNC_STAMP" ] || return 1
    [ -n "$(find "$SYNC_STAMP" -mmin "-$SYNC_FRESH_MIN" 2>/dev/null)" ] || return 1
    [ -z "$(find /etc/xbps.d /usr/share/xbps.d -newer "$SYNC_STAMP" 2>/dev/null)" ] || return 1
    lists=$(xbps-query -L 2>/dev/null) || return 1
    [ -n "$lists" ] && ! printf '%s\n' "$lists" | grep -q '^[[:space:]]*-1[[:space:]]'
}

# Update the package lists, retrying network failures before giving up.
# Returns 0 on success, 1 when a repository stayed unreachable, 2 when the
# privilege tool refused (wrong password).
sync_repos() {
    tries=${ABYSS_SYNC_TRIES:-3} n=1
    log=$(mktemp "${TMPDIR:-/tmp}/abyss-sync.XXXXXX") || return 1
    while :; do
        echo "Updating package lists (attempt $n of $tries)..."
        # Stream the output: xbps may ask to import a repository key.
        { abyss-priv xbps-install -S; echo $? >"$log.rc"; } 2>&1 | tee "$log"
        rc=$(cat "$log.rc" 2>/dev/null || echo 1); rm -f "$log.rc"
        if [ "$rc" -eq 0 ] && ! grep -q 'ERROR' "$log"; then
            rm -f "$log"; : > "$SYNC_STAMP" 2>/dev/null; return 0
        fi
        if grep -qiE 'authentication failed|incorrect password|not permitted|doas or sudo' "$log"; then
            rm -f "$log"; echo; echo 'Installing software needs your password (doas or sudo).'; return 2
        fi
        [ "$n" -lt "$tries" ] || break
        pause=${ABYSS_RETRY_PAUSE:-5}
        echo "A package server could not be reached; trying again in ${pause}s..."
        sleep "$pause"
        n=$((n + 1))
    done
    explain_sync_failure "$log"
    rm -f "$log"
    return 1
}

# "DOWNLOAD INSTALLED" bytes for installing the packages, from a dry run with
# the package lists already on disk (no root needed). Fails if xbps cannot.
dry_run_size() {
    out=$(xbps-install -n "$@" 2>/dev/null) || return 1
    printf '%s\n' "$out" | awk '$2 ~ /^(install|update|reinstall|downgrade)$/ { i += $5; d += $6 }
        END { printf "%.0f %.0f\n", d, i }'
}

human() {
    awk -v b="$1" 'BEGIN { if (b >= 1073741824) printf "%.1f GB", b / 1073741824;
        else if (b >= 1048576) printf "%.0f MB", b / 1048576; else printf "%.0f KB", b / 1024 }'
}

# Runs inside the install terminal (or from a shell: abyss-software
# --run-install [--yes] PKG...). Never stops a bundle silently: missing
# packages are reported by name and the rest is still installed.
run_install() {
    # Ask for the password once: run the whole install as root. The marker
    # file tells a refused password apart from a failed install.
    if [ "${1:-}" = --elevated ]; then
        rm -f "$2"; shift 2
    elif [ "$(id -u)" -ne 0 ]; then
        mark=$(mktemp "${TMPDIR:-/tmp}/abyss-elevate.XXXXXX") || return 1
        echo 'Changing installed software needs administrator rights.'
        abyss-priv /bin/sh "$SELF" --run-install --elevated "$mark" "$@"; rc=$?
        if [ -e "$mark" ]; then
            rm -f "$mark"; echo; echo 'Installing software needs your password (doas or sudo). Nothing was installed.'
            return 1
        fi
        return "$rc"
    fi
    yes= update=
    while :; do
        case ${1:-} in
            --yes) yes=-y; shift ;;
            --update) update=-u; shift ;;   # bring installed packages up to date
            *) break ;;
        esac
    done
    arch=$(machine_arch)
    wait_for_xbps
    # Installing reuses lists synced moments ago; updating always syncs.
    if [ -z "$update" ] && repos_fresh; then
        echo "Package lists are up to date (updated less than $SYNC_FRESH_MIN minutes ago)."
        rc=0
    else
        sync_repos; rc=$?
    fi
    [ "$rc" -eq 2 ] && return 1
    [ "$rc" -eq 0 ] || echo 'Continuing with the package lists already on this computer.'
    ok= missing= broken=
    for pkg; do
        if xbps-query -R "$pkg" >/dev/null 2>&1; then ok="$ok $pkg"; else missing="$missing $pkg"; fi
    done
    if [ -n "$ok" ] && ! xbps-install -n $update $ok >/dev/null 2>&1; then
        keep=
        for pkg in $ok; do
            if xbps-install -n $update "$pkg" >/dev/null 2>&1; then keep="$keep $pkg"; else broken="$broken $pkg"; fi
        done
        ok=$keep
    fi
    status=1
    if [ -n "$ok" ]; then
        if sizes=$(dry_run_size $update $ok); then
            set -- $sizes
            [ "$1" -eq 0 ] || { echo; echo "Download: $(human "$1"), disk space needed: $(human "$2")"; }
        fi
        if [ -n "$update" ]; then echo "Updating:$ok"; else echo "Installing:$ok"; fi
        wait_for_xbps
        abyss-priv xbps-install $yes $update $ok; status=$?
    fi
    # Trust the package database, not the exit status: answering "n" at the
    # xbps prompt exits 0 without installing anything.
    done_= notdone=
    for pkg in $ok; do
        if xbps-query "$pkg" >/dev/null 2>&1; then done_="$done_ $pkg"; else notdone="$notdone $pkg"; fi
    done
    echo
    echo '==================== Summary ===================='
    if [ -n "$done_" ]; then
        if [ -n "$update" ]; then echo "Up to date:$done_"; else echo "Installed:$done_"; fi
    fi
    if [ -n "$notdone" ] && [ "$status" -eq 0 ]; then
        echo "Not installed (cancelled):$notdone"
    elif [ -n "$notdone" ] || [ "$status" -ne 0 ]; then
        echo "Not installed:$notdone (xbps-install exit $status; see the messages above)"
    fi
    [ -z "$missing" ] || echo "Not available for $arch in the enabled repositories:$missing"
    [ -z "$broken" ] || echo "Cannot be installed on this system (dependency problem):$broken"
    [ -n "$ok" ] || echo 'Nothing was installed.'
    [ "$rc" -eq 0 ] || echo 'Note: the package lists could not be updated, so these results may be out of date.'
    [ -n "$ok" ] && [ "$status" -eq 0 ] && [ -z "$missing$broken$notdone" ]
}

install_packages() {  # install_packages "word..." (words may carry @arch)
    arch=$(machine_arch)
    packages=$(arch_packages "$arch" "$1")
    if ! valid_names "$packages"; then
        note 'Nothing to install' "None of these packages is offered for $arch: $1"
        return 1
    fi
    if sizes=$(dry_run_size $packages); then
        set -- $sizes
        if [ "$1" -ge "$BIG_DOWNLOAD" ]; then
            answer=$(printf 'Install (downloads %s, needs %s of disk)\nCancel\n' "$(human "$1")" "$(human "$2")" |
                choose -p 'Large download')
            case $answer in Install*) ;; *) return 1 ;; esac
        fi
    fi
    xbps_busy && note 'Another install or update is running' 'This one will start when it finishes.'
    term 'Install software' "/bin/sh '$SELF' --run-install $packages"
}

search_packages() {
    query=$(printf '' | choose -p 'Search Void packages') || return
    [ -n "$query" ] || return
    # Lines are "[-] name-version_revision  description"; the version never
    # contains a dash, so the name is everything before the last one.
    results=$(xbps-query -Rs "$query" 2>/dev/null | awk '
        { line=$0; sub(/^\[[^]]+\][[:space:]]*/, "", line); $0=line; pkg=$1; sub(/-[^-]*$/, "", pkg); $1=""; sub(/^[[:space:]]+/, ""); if (pkg != "") printf "%s — %s\n", pkg, $0 }
    ' | sort -u)
    [ -n "$results" ] || { note 'No packages found' "$query"; return; }
    choice=$(printf '%s\n' "$results" | choose -p 'Void packages (type to filter)')
    selected=$(printf '%s\n' "$choice" | sed 's/ —.*//')
    [ -n "$selected" ] || return
    [ "$(printf 'Install %s\nCancel\n' "$selected" | choose -p 'Confirm')" = "Install $selected" ] || return 1
    install_packages "$selected"
}

install_vscode() {
    case "$(uname -m)" in
        x86_64) arch=x64; folder=VSCode-linux-x64 ;;
        aarch64) arch=arm64; folder=VSCode-linux-arm64 ;;
        *) note 'VS Code unavailable' "Unsupported architecture: $(uname -m)"; return 1 ;;
    esac
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/abyss-vscode.XXXXXX") || return 1
    if ! curl -fL --proto '=https' --tlsv1.2 "https://update.code.visualstudio.com/latest/linux-$arch/stable" -o "$tmp/code.tar.gz"; then
        rm -rf "$tmp"; note 'Download failed' 'Could not download VS Code from Microsoft.'; return 1
    fi
    mkdir -p "$HOME/.local/opt" "$HOME/.local/bin" "$HOME/.local/share/applications"
    tar -xzf "$tmp/code.tar.gz" -C "$tmp" || { rm -rf "$tmp"; return 1; }
    rm -rf "$HOME/.local/opt/vscode"
    mv "$tmp/$folder" "$HOME/.local/opt/vscode" || { rm -rf "$tmp"; return 1; }
    ln -sf "$HOME/.local/opt/vscode/code" "$HOME/.local/bin/code"
    cat > "$HOME/.local/share/applications/abyss-vscode.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Visual Studio Code
Exec=$HOME/.local/opt/vscode/code %F
Icon=$HOME/.local/opt/vscode/resources/app/resources/linux/code.png
Terminal=false
Categories=Development;IDE;
EOF
    rm -rf "$tmp"
    note 'VS Code installed' 'Microsoft latest stable archive installed in ~/.local/opt/vscode.'
}

install_artcraft() {
    case "$(uname -m)" in x86_64) arch=x86_64 ;; aarch64) arch=aarch64 ;; *) note 'ArtCraft unavailable' "Unsupported architecture: $(uname -m)"; return 1 ;; esac
    api=https://api.github.com/repos/storytold/craft-launcher/releases/latest
    release=$(curl -fsSL --proto '=https' --tlsv1.2 "$api") || { note 'ArtCraft download unavailable' 'Could not read the latest official release.'; return 1; }
    tag=$(printf '%s\n' "$release" | awk -F '"' '/"tag_name":/ { print $4; exit }')
    url=$(printf '%s\n' "$release" | awk -v suffix="linux-$arch.AppImage" '/"browser_download_url":/ { u=$0; sub(/^.*"browser_download_url":[[:space:]]*"/, "", u); sub(/"[,]?$/, "", u); if (u ~ suffix "$" && u ~ /^https:\/\/github\.com\/storytold\/craft-launcher\/releases\/download\//) { print u; exit } }')
    case "$tag" in *[!A-Za-z0-9._-]*|'') tag= ;; esac
    [ -n "$tag" ] || { note 'ArtCraft download unavailable' 'Could not determine the latest official release tag.'; return 1; }
    [ -n "$url" ] || { note 'ArtCraft download unavailable' 'Could not find the latest official AppImage release.'; return 1; }
    file=${url##*/}
    # Pin the checksum file to the same release as the API asset; the moving
    # /latest/download endpoint can change between the two requests.
    sums="https://github.com/storytold/craft-launcher/releases/download/$tag/SHA256SUMS.txt"
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/abyss-artcraft.XXXXXX") || return 1
    if ! curl -fL --proto '=https' --tlsv1.2 "$url" -o "$tmp/$file" || ! curl -fL --proto '=https' --tlsv1.2 "$sums" -o "$tmp/SHA256SUMS.txt"; then
        rm -rf "$tmp"; note 'Download failed' 'Could not download ArtCraft and its checksum.'; return 1
    fi
    expected=$(awk -v f="$file" '{ name=$2; sub(/^\*/, "", name); if (name == f) { print $1; exit } }' "$tmp/SHA256SUMS.txt")
    actual=$(sha256sum "$tmp/$file" | awk '{print $1}')
    if ! printf '%s\n' "$expected" | grep -Eq '^[[:xdigit:]]{64}$' || [ "$actual" != "$expected" ]; then
        rm -rf "$tmp"; note 'Checksum failed' 'The ArtCraft download did not match its published checksum.'; return 1;
    fi
    mkdir -p "$HOME/.local/opt" "$HOME/.local/bin" "$HOME/.local/share/applications"
    install -m 0755 "$tmp/$file" "$HOME/.local/opt/artcraft-launcher.AppImage"
    ln -sf "$HOME/.local/opt/artcraft-launcher.AppImage" "$HOME/.local/bin/artcraft-launcher"
    cat > "$HOME/.local/share/applications/artcraft-launcher.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=ArtCraft Launcher
Exec=$HOME/.local/opt/artcraft-launcher.AppImage
Terminal=false
Categories=Graphics;
EOF
    rm -rf "$tmp"
    note 'ArtCraft Launcher installed' 'Latest official release installed in ~/.local/opt.'
}

install_cursor() {
    case "$(uname -m)" in x86_64) arch=x64 ;; aarch64) arch=arm64 ;; *) note 'Cursor unavailable' "Unsupported architecture: $(uname -m)"; return 1 ;; esac
    page=https://cursor.com/download
    url=$(curl -fsSL --proto '=https' --tlsv1.2 "$page" | sed 's#\\/#/#g' | grep -oE "https://api2\\.cursor\\.sh/updates/download/golden/linux-$arch/cursor/[0-9.]+" | head -n 1)
    case "$url" in https://api2.cursor.sh/updates/download/golden/linux-"$arch"/cursor/[0-9.]*) ;; *) note 'Cursor download unavailable' 'Could not resolve the latest official AppImage download.'; return 1 ;; esac
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/abyss-cursor.XXXXXX") || return 1
    if ! curl -fL --proto '=https' --tlsv1.2 "$url" -o "$tmp/cursor.AppImage"; then
        rm -rf "$tmp"; note 'Download failed' 'Could not download Cursor from its official release service.'; return 1
    fi
    mkdir -p "$HOME/.local/opt" "$HOME/.local/bin" "$HOME/.local/share/applications"
    install -m 0755 "$tmp/cursor.AppImage" "$HOME/.local/opt/cursor.AppImage"
    ln -sf "$HOME/.local/opt/cursor.AppImage" "$HOME/.local/bin/cursor"
    cat > "$HOME/.local/share/applications/cursor.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Cursor
Exec=$HOME/.local/opt/cursor.AppImage --appimage-extract-and-run %F
Terminal=false
Categories=Development;IDE;
EOF
    rm -rf "$tmp"
    note 'Cursor installed' 'Latest official Linux AppImage installed in ~/.local/opt.'
}

install_ollama() {
    if [ "$(printf 'Install latest Ollama\nCancel\n' | choose -p 'This runs Ollama’s official system installer')" = 'Install latest Ollama' ]; then
        term 'Install Ollama' 'curl -fsSL --proto "=https" --tlsv1.2 https://ollama.com/install.sh | abyss-priv sh'
    fi
}

install_claude_code() {
    if [ "$(printf 'Install latest Claude Code CLI\nCancel\n' | choose -p 'This installs to your home directory')" = 'Install latest Claude Code CLI' ]; then
        term 'Install Claude Code' 'curl -fsSL --proto "=https" --tlsv1.2 https://claude.ai/install.sh | bash'
    fi
}

install_opencode() {
    if [ "$(printf 'Install latest OpenCode CLI\nCancel\n' | choose -p 'This installs to your home directory')" = 'Install latest OpenCode CLI' ]; then
        term 'Install OpenCode' 'curl -fsSL --proto "=https" --tlsv1.2 https://opencode.ai/v2/install | bash'
    fi
}

open_official_page() {
    url=$1
    for browser in firefox google-chrome chromium; do
        if has "$browser"; then setsid -f "$browser" "$url" >/dev/null 2>&1; return; fi
    done
    term 'Official download' "printf '%s\\n\\n' 'Open this official page after installing a browser:' '$url'; printf 'Press Enter to close '; read _"
}

# label<TAB>action[<TAB>architectures]. Package names must exist in the Void
# repositories (tests/test_software_packages.py checks them for x86_64 and
# aarch64); a package or entry that exists on one architecture only carries
# its architectures (pkg:foo@x86_64, or a third column x86_64) and is hidden
# elsewhere. Thunar is spelled with a capital T in Void; PipeWire's pulse
# server is part of the pipewire package.
catalog() {
    if [ -n "${ABYSS_SOFTWARE_CATALOG:-}" ]; then cat "$ABYSS_SOFTWARE_CATALOG"; return; fi
    cat <<'EOF'
Firefox (Void package)	pkg:firefox
Google Chrome (official download)	chrome
Chromium (Void package)	pkg:chromium
Virtual machines (QEMU + virt-manager)	pkg:qemu libvirt virt-manager bridge-utils
Docker Engine	pkg:docker docker-compose docker-buildx
VLC media player	pkg:vlc
External storage (udisks + GVFS)	pkg:udisks2 gvfs Thunar
Visual Studio Code (latest stable)	vscode
ArtCraft Launcher	artcraft
Ollama (official installer)	ollama
Claude Code CLI	claude-code
OpenCode CLI	opencode
Google Antigravity (download page)	antigravity
Cursor (latest AppImage)	cursor
ChatGPT (web app)	chatgpt
Audio support (PipeWire + mixer)	pkg:pipewire wireplumber pavucontrol
Terminal workspace (Vim, lf, fzf, ripgrep, tmux)	pkg:vim lf fzf ripgrep tmux
Passwords (pass + browser autofill)	pkg:pass pass-otp browserpass pinentry-gtk xclip
Writing and research (TeX Live, Zathura; about 1.8 GB download)	pkg:vim texlive zathura zathura-pdf-mupdf
Media tools (mpv, yt-dlp, ffmpeg)	pkg:mpv yt-dlp ffmpeg xclip
Bluetooth support	pkg:bluez
Laptop brightness controls	pkg:brightnessctl
Screenshot capture (optional)	pkg:maim
Search Void packages	search
EOF
}

# The menu for ARCH: entries not offered there are left out, bundles lose the
# packages that do not exist there, and single-architecture entries say so.
entries() {  # entries ARCH
    catalog | while IFS='	' read -r label action arches; do
        offered_on "$1" "$arches" || continue
        case $action in
            pkg:*) pkgs=$(arch_packages "$1" "${action#pkg:}"); [ -n "$pkgs" ] || continue; action="pkg:$pkgs" ;;
        esac
        case ${arches:-all} in all) ;; *) label="$label (only on $(printf '%s' "$arches" | sed 's/,/, /g'))" ;; esac
        printf '%s\t%s\n' "$label" "$action"
    done
}

# Names of the installed packages, one per line (one local xbps-query call).
installed_packages() {
    xbps-query -l 2>/dev/null | awk '{ n = $2; sub(/-[^-]*$/, "", n); print n }'
}

# entries ARCH, with a third column: installed state of a package bundle
# (all, part:<missing names> or none; empty for other actions). Installed
# bundles are marked in the label so the menu shows them at a glance.
menu_entries() {
    have=$(installed_packages)
    entries "$1" | while IFS='	' read -r label action; do
        state=
        case $action in pkg:*)
            missing=
            for pkg in ${action#pkg:}; do
                printf '%s\n' "$have" | grep -qxF "$pkg" || missing="$missing $pkg"
            done
            if [ -z "$missing" ]; then state=all; label="$label  ✓ installed"
            elif [ "$missing" = " ${action#pkg:}" ]; then state=none
            else state="part:${missing# }"; label="$label  (partly installed, missing:$missing)"; fi ;;
        esac
        printf '%s\t%s\t%s\n' "$label" "$action" "$state"
    done
}

# The first package of a bundle that is a desktop application, as a command.
app_command() {
    for pkg in $1; do
        cmd=$(printf '%s' "$pkg" | tr 'A-Z' 'a-z')
        if has "$cmd" && [ -e "${ABYSS_APPLICATIONS_DIR:-/usr/share/applications}/$cmd.desktop" ]; then
            printf '%s\n' "$cmd"; return 0
        fi
    done
    return 1
}

remove_packages() {  # remove_packages "name..."
    valid_names "$1" || return 1
    answer=$(printf 'Remove %s\nCancel\n' "$1" | choose -p 'Remove (unused dependencies go too)')
    [ "$answer" = "Remove $1" ] || return 1
    term 'Remove software' "/bin/sh '$SELF' --run-remove $1"
}

run_remove() {
    wait_for_xbps
    abyss-priv xbps-remove -R "$@"; status=$?
    echo
    echo '==================== Summary ===================='
    if [ "$status" -eq 0 ]; then echo "Removed: $*"
    else echo "Removing $* did not finish (xbps-remove exit $status); see the messages above."; fi
    return "$status"
}

# A bundle that is already (partly) installed: offer what makes sense
# instead of a blind install.
installed_actions() {  # installed_actions "pkg..." STATE
    pkgs=$1 state=$2 options=
    if [ "$state" = all ]; then
        cmd=$(app_command "$pkgs") && options="Open $cmd
"
        options="${options}Update
Remove
Back"
        prompt='Installed'
    else
        missing=${state#part:}
        present=
        for pkg in $pkgs; do case " $missing " in *" $pkg "*) ;; *) present="$present $pkg" ;; esac; done
        options="Install missing: $missing
Remove installed parts:$present
Back"
        prompt='Partly installed'
    fi
    choice=$(printf '%s\n' "$options" | choose -p "$prompt") || return 1
    case $choice in
        "Open "*) setsid -f "${choice#Open }" >/dev/null 2>&1 ;;
        Update) term 'Update software' "/bin/sh '$SELF' --run-install --update $pkgs" ;;
        Remove) remove_packages "$pkgs" ;;
        'Install missing: '*) install_packages "$missing" ;;
        'Remove installed parts:'*) remove_packages "${present# }" ;;
        *) return 1 ;;
    esac
}

case "${1:-}" in
    --search) search_packages; exit 0 ;;
    --list-entries) entries "${2:-$(machine_arch)}"; exit 0 ;;
    --run-install) shift; run_install "$@"; exit $? ;;
    --run-remove) shift; run_remove "$@"; exit $? ;;
    --install) [ -n "${2:-}" ] || exit 2; install_packages "$2"; exit $? ;;
esac

while :; do
    menu=$(menu_entries "$(machine_arch)")   # re-read: an install may have finished
    selection=$(printf '%s\n' "$menu" | cut -f1 | choose -p 'Software (type to filter)') || exit 0
    line=$(printf '%s\n' "$menu" | awk -F '\t' -v label="$selection" '$1 == label { print; exit }')
    action=$(printf '%s\n' "$line" | cut -f2)
    state=$(printf '%s\n' "$line" | cut -f3)
    case "$action" in
        # Close the menu once a terminal is open, so it can take the password.
        pkg:*) case $state in
                   all|part:*) installed_actions "${action#pkg:}" "$state" && exit 0 ;;
                   *) install_packages "${action#pkg:}" && exit 0 ;;
               esac ;;
        chrome) open_official_page 'https://www.google.com/chrome/' ;;
        vscode) install_vscode ;;
        artcraft) install_artcraft ;;
        ollama) install_ollama ;;
        claude-code) install_claude_code ;;
        opencode) install_opencode ;;
        antigravity) open_official_page 'https://antigravity.google/download?os=linux' ;;
        cursor) install_cursor ;;
        chatgpt) open_official_page 'https://chatgpt.com' ;;
        search) search_packages && exit 0 ;;
        *) exit 0 ;;
    esac
done
